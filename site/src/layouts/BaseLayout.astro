---
import '../styles/global.css';
import MobileBottomTab from '../components/MobileBottomTab.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  activeTab?: string;
}

const { title, description = 'エミエルを愛しすぎている個人ファンが運営する架空のレビュー日誌サイト', ogImage = '/og/og-default.png', activeTab } = Astro.props;
const fullTitle = `${title} | my EMIEL diary review`;
const dotsClass = activeTab === 'home' ? 'dots-scatter' : 'dots-corners';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Klee+One:wght@400;600&family=Caveat:wght@400;700&family=Yusei+Magic&family=RocknRoll+One&family=M+PLUS+Rounded+1c:wght@400;700;800;900&display=swap"
    />
    <title>{fullTitle}</title>
  </head>
  <body class={dotsClass}>
    <slot />
    <MobileBottomTab active={activeTab} />
  </body>
</html>
