---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewImage from '../components/ReviewImage.astro';
import HeartsRating from '../components/HeartsRating.astro';
import BearDoodle from '../components/BearDoodle.astro';
import Cloud from '../components/Cloud.astro';
import { listReviews } from '../lib/microcms.ts';

const { contents: all } = await listReviews({ orders: '-rating,-date', limit: 100 });

// Ranking tabs — mix of cat-based and mood-based filters
type RankingTab = { label: string; key: string; filter: (r: typeof all[number]) => boolean };
const rankingTabs: RankingTab[] = [
  { label: '総合ランキング', key: 'all', filter: () => true },
  { label: '期間限定', key: '期間限定', filter: (r) => r.cat === '期間限定' },
  { label: 'コラボ', key: 'コラボ', filter: (r) => r.cat === 'コラボ' },
  { label: '新商品', key: '新商品', filter: (r) => r.cat === '新商品' },
];
// Pre-compute top3 per tab so client-side switching is purely a visibility toggle
const top3ByCat = Object.fromEntries(
  rankingTabs.map((t) => [t.key, all.filter(t.filter).slice(0, 3)]),
) as Record<string, typeof all>;
const top3 = top3ByCat['all'];

const themes = [
  {
    title: 'さっぱり系',
    sub: 'ゴクゴク飲める！きっぱりおいしいエミエル',
    icon: '✿',
    href: '/reviews?mood=さっぱり',
    items: all.filter((r) => r.mood?.includes('さっぱり')).slice(0, 3),
  },
  {
    title: '甘い系',
    sub: '甘くてまろやか！幸せになれる味わい',
    icon: '♡',
    href: '/reviews?mood=甘め,濃厚',
    items: all.filter((r) => r.mood?.includes('甘め') || r.mood?.includes('濃厚')).slice(0, 3),
  },
  {
    title: '夏に飲みたい！',
    sub: '暑い日にぴったりな爽やかエミエル',
    icon: '☀',
    href: '/reviews?season=夏',
    items: all.filter((r) => r.season === '夏').slice(0, 3),
  },
  {
    title: '限定・コラボ',
    sub: '出会えたらラッキー♡特別なエミエルたち',
    icon: '✦',
    href: '/reviews?cat=コラボ,期間限定',
    items: all.filter((r) => r.cat === 'コラボ' || r.cat === '期間限定').slice(0, 3),
  },
];
---
<BaseLayout title="ranking" activeTab="ranking">
  <Header active="ranking" />

  <div class="rk-desktop">
  <section class="head">
    <div>
      <h1>ranking <span>♔</span></h1>
      <p>これまで飲んできたエミエルたちの<br />中から、特にお気に入りをランキングにしました！</p>
    </div>
    <div class="bear-bubble">
      <BearDoodle size={72} class="mayou-bear" />
      <img class="mayou-bubble" src="/images/bubble-mayou.png" alt="どの子もおいしくて 本当に迷っちゃう…！" />
    </div>
    <div class="criteria">
      <div class="criteria-h">♔ rankingについて</div>
      <p>評価は「味のおいしさ」「飲みやすさ」「あと味」「特別感」「リピートしたさ」の5つのポイントをもとに、5.0点満点でつけています。</p>
    </div>
  </section>

  <div class="rk-tabs" data-rk-tabs>
    {rankingTabs.map((t, i) => (
      <button
        type="button"
        class={`rk-tab ${i === 0 ? 'active' : ''}`}
        data-rk-tab={t.key}
      >{t.label}</button>
    ))}
  </div>

  {rankingTabs.map((t, i) => (
    <section class={`top3 ${i === 0 ? 'active' : ''}`} data-rk-pane={t.key}>
      {top3ByCat[t.key].length === 0 ? (
        <div class="rk-empty">該当する商品はまだありません</div>
      ) : (
        top3ByCat[t.key].map((r, ri) => (
          <a href={`/reviews/${r.slug}`} class={`tcard ${ri === 0 ? 'highlight' : ''}`}>
            <div class="rank-no">No.{ri + 1}</div>
            <ReviewImage r={r} variant="card" height={140} />
            <div class="tinfo">
              <h3>エミエル {r.name}</h3>
              <HeartsRating value={r.rating} size={12} />
              <p>{r.oneLiner}</p>
              <div class="tags">
                {(r.tags ?? []).slice(0, 3).map((tg) => <span>#{tg}</span>)}
              </div>
            </div>
          </a>
        ))
      )}
    </section>
  ))}

  <section class="themes-wrap">
    <h2>✦ テーマ別ランキング</h2>
    <div class="themes">
      {themes.map((th) => (
        <div class="theme">
          <div class="theme-h"><span class="ico">{th.icon}</span>{th.title}</div>
          <div class="theme-sub">{th.sub}</div>
          {th.items.length === 0 && <div class="empty">該当する商品はまだありません</div>}
          {th.items.map((r, i) => (
            <a href={`/reviews/${r.slug}`} class="trow">
              <span class="rn">{i + 1}</span>
              <ReviewImage r={r} variant="card" height={44} />
              <span class="rname">エミエル {r.name}</span>
              <HeartsRating value={r.rating} size={11} showValue={false} />
            </a>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="myfav">
    <div class="fav-card">
      <BearDoodle size={60} />
      <div>
        <div class="fav-title">my favorite ♡</div>
        <p>やっぱり、No.1の<br />「エミエル {top3[0]?.name}」が特別！<br />この濃さとコクは唯一無二〜</p>
      </div>
    </div>
    <div class="sns-card">
      <div class="cloud-deco"><Cloud width={120} fill="rgba(255,255,255,0.5)" /></div>
      <p>あなたのおすすめも教えてね！<br />SNSでもエミエル愛を発信中☺</p>
      <div class="sns-icons">
        <span>IG</span><span>X</span><span>YT</span>
      </div>
    </div>
  </section>
  </div>

  <!-- ─────────────── MOBILE LAYOUT ─────────────── -->
  <div class="rk-mobile">
    <!-- title -->
    <section class="mrk-title">
      <svg class="mrk-title-star" width="34" height="30" viewBox="0 0 40 32" aria-hidden="true">
        <path d="M4 26 L8 8 L18 18 L20 4 L22 18 L32 8 L36 26 Z" fill="#cfe3f4"/>
      </svg>
      <div>
        <h1>Ranking</h1>
        <p>みんなのレビューをもとにした人気ランキング</p>
      </div>
    </section>

    <!-- category tabs -->
    <div class="mrk-tabs" data-rk-tabs>
      {rankingTabs.map((t, i) => (
        <button
          type="button"
          class={`mrk-tab ${i === 0 ? 'active' : ''}`}
          data-rk-tab={t.key}
        >{t.label}</button>
      ))}
    </div>

    <!-- podium (Top3) -->
    {rankingTabs.map((t, ti) => {
      const list = top3ByCat[t.key];
      return (
        <section class={`mrk-podium ${ti === 0 ? 'active' : ''}`} data-rk-pane={t.key}>
          {list.length < 3 ? (
            <div class="mrk-empty">該当する商品はまだありません</div>
          ) : (
            [1, 0, 2].map((idx) => {
              const r = list[idx];
              const isFirst = idx === 0;
              const crowns = ['#f5c84a', '#c0c5cc', '#cf8a4a'];
              return (
                <a class={`mrk-pod ${isFirst ? 'mrk-pod-first' : ''}`} href={`/reviews/${r.slug}`}>
                  <svg class="mrk-pod-crown" width="36" height="22" viewBox="0 0 40 22" aria-hidden="true">
                    <path d="M4 18 L8 4 L16 12 L20 2 L24 12 L32 4 L36 18 Z" fill={crowns[idx]} />
                  </svg>
                  <div class="mrk-pod-card" style={`--crown:${crowns[idx]};`}>
                    <span class="mrk-pod-no">{idx + 1}</span>
                    <div class={`mrk-pod-img ${isFirst ? 'is-first' : ''}`}>
                      <ReviewImage r={r} variant="card" height={isFirst ? 110 : 92} />
                    </div>
                    <div class="mrk-pod-name">エミエル {r.name}</div>
                    <div class="mrk-pod-stars">
                      <HeartsRating value={r.rating} size={10} showValue={false} />
                    </div>
                    <div class="mrk-pod-pill">★ {r.rating.toFixed(1)}</div>
                  </div>
                </a>
              );
            })
          )}
        </section>
      );
    })}

    <!-- theme-based rankings -->
    <section class="mrk-themes">
      <h2 class="mrk-themes-title">✦ テーマ別ランキング</h2>
      {themes.map((th) => (
        <div class="mrk-theme">
          <div class="mrk-theme-head">
            <span class="mrk-theme-icon">{th.icon}</span>
            <div class="mrk-theme-text">
              <div class="mrk-theme-name">{th.title}</div>
              <div class="mrk-theme-sub">{th.sub}</div>
            </div>
          </div>
          {th.items.length === 0 ? (
            <div class="mrk-theme-empty">該当する商品はまだありません</div>
          ) : (
            <div class="mrk-theme-list">
              {th.items.map((r, i) => (
                <a class="mrk-theme-row" href={`/reviews/${r.slug}`}>
                  <span class="mrk-theme-rank">{i + 1}</span>
                  <div class="mrk-theme-img">
                    <ReviewImage r={r} variant="card" height={44} />
                  </div>
                  <div class="mrk-theme-info">
                    <div class="mrk-theme-product">エミエル {r.name}</div>
                    <HeartsRating value={r.rating} size={10} showValue={false} />
                  </div>
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </section>

    <!-- criteria -->
    <section class="mrk-criteria">
      <div class="mrk-criteria-card">
        <div class="mrk-criteria-h">♔ rankingについて</div>
        <p>評価は「味のおいしさ」「飲みやすさ」「あと味」「特別感」「リピートしたさ」の5つのポイントをもとに、5.0点満点でつけています。</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="mrk-cta">
      <div class="mrk-cta-card">
        <svg class="mrk-cta-dots" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true">
          <circle cx="20" cy="16" r="2" fill="#cfe3f4"/>
          <circle cx="40" cy="40" r="1.6" fill="#cfe3f4"/>
          <circle cx="14" cy="76" r="2" fill="#cfe3f4"/>
          <circle cx="80" cy="16" r="1.5" fill="#cfe3f4"/>
        </svg>
        <div class="mrk-cta-text">
          あなたの推しエミエルは<br />ランキングに入ってるかな？
        </div>
        <div class="mrk-cta-art">
          <BearDoodle size={52} />
        </div>
      </div>
      <div class="mrk-cta-btn-wrap">
        <a class="mrk-cta-btn" href="/reviews">
          <span aria-hidden="true">✎</span> レビューを見る
        </a>
      </div>
    </section>
  </div>

  <Footer variant="ranking" />
</BaseLayout>

<style>
.head {
  padding: 0 40px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
  align-items: center;
}
.head h1 { font-family: var(--font-display); font-style: italic; font-size: var(--fs-hero); color: var(--accent); margin: 0; line-height: 1; }
.head h1 span { font-size: 28px; }
.head p { font-size: 12px; margin-top: 8px; color: var(--ink-tertiary); }
.bear-bubble {
  display: inline-flex;
  align-items: flex-end;
}
.mayou-bubble {
  width: 200px;
  height: auto;
  display: block;
  margin-left: 8px;
  margin-bottom: 6px;
}
.criteria {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 14px;
  padding: 14px;
}
.criteria-h { font-size: 11px; font-weight: 600; color: var(--accent); margin-bottom: 6px; }
.criteria p { font-size: 11px; line-height: 1.6; color: var(--ink-tertiary); margin: 0; }

.rk-tabs {
  display: flex;
  gap: 8px;
  padding: 0 40px 36px;
  flex-wrap: wrap;
}
.rk-tab {
  padding: 8px 18px;
  font-size: 13px;
  font-family: var(--font-jp);
  color: var(--ink-tertiary);
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 999.008px;
  cursor: pointer;
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.rk-tab:hover:not(.active) {
  background: rgba(122, 169, 217, 0.08);
  color: var(--accent);
}
.rk-tab.active {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
/* desktop & mobile: hide non-active panes */
.top3:not(.active),
.mrk-podium:not(.active) { display: none; }
.rk-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px 16px;
  font-size: 12px;
  color: var(--ink-tertiary-2);
}
.mrk-empty {
  text-align: center;
  padding: 24px 16px;
  font-size: 12px;
  color: var(--ink-tertiary-2);
}

.top3 {
  padding: 0 40px 30px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
}
.tcard {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 18px;
  position: relative;
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 14px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.tcard.highlight { border: 2px solid var(--accent); }
.rank-no {
  position: absolute;
  top: -22px;
  left: 10px;
  font-family: var(--font-display);
  font-size: 36px;
  font-style: italic;
  color: var(--accent);
  font-weight: 700;
  line-height: 1;
}
.tinfo h3 { font-size: 16px; font-weight: 700; color: var(--ink-primary); margin: 0 0 6px; font-family: var(--font-jp); }
.tinfo p { font-size: 11px; line-height: 1.6; margin-top: 8px; color: var(--ink-secondary); }
.tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.tags span { font-size: 9px; color: var(--accent); opacity: 0.75; }

.themes-wrap { padding: 0 40px 30px; }
.themes-wrap h2 { font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 14px; font-family: var(--font-jp); }
.themes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.theme {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 14px;
  padding: 14px;
}
.theme-h { font-size: 13px; font-weight: 700; color: var(--ink-primary); font-family: var(--font-jp); }
.theme-h .ico { margin-right: 6px; }
.theme-sub { font-size: 10px; color: var(--ink-tertiary-2); margin: 4px 0 10px; }
.trow {
  display: grid;
  grid-template-columns: 22px 44px 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px dashed rgba(168, 200, 232, 0.3);
  text-decoration: none;
  color: inherit;
}
.rn { font-size: 18px; font-family: var(--font-display); font-style: italic; color: var(--accent); font-weight: 700; }
.rname { font-size: 13px; color: var(--ink-primary); line-height: 1.3; }
.empty { font-size: 11px; color: var(--ink-muted); padding: 12px 0; }

.myfav {
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.fav-card {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 16px;
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 14px;
  align-items: center;
  position: relative;
}
.fav-title { font-family: var(--font-display); font-style: italic; font-size: 14px; color: var(--accent); }
.fav-card p { font-size: 11px; line-height: 1.6; color: var(--ink-secondary); margin: 6px 0 0; }

.sns-card {
  background: linear-gradient(135deg, #c8e0f3 0%, #eaf4fc 100%);
  border-radius: 18px;
  padding: 16px;
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
}
.cloud-deco { position: absolute; top: 0; right: 0; }
.sns-card p { font-size: 12px; color: var(--ink-primary); flex: 1; line-height: 1.6; position: relative; }
.sns-icons { display: flex; gap: 8px; position: relative; }
.sns-icons span {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: var(--accent);
  font-family: var(--font-display);
}

/* ─────────────── MOBILE LAYOUT ─────────────── */
.rk-mobile { display: none; }

@media (max-width: 768px) {
  .rk-desktop { display: none; }
  .rk-mobile { display: block; }
  body { padding-bottom: 64px; }

  /* title */
  .mrk-title {
    padding: 14px 18px 6px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .mrk-title-star { flex-shrink: 0; margin-top: 2px; }
  .mrk-title h1 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 28px;
    color: #1f5fa8;
    margin: 0;
    line-height: 1;
  }
  .mrk-title p {
    font-size: 11px;
    color: #5a7a98;
    margin: 4px 0 0;
    font-family: var(--font-jp);
  }

  /* category tabs */
  .mrk-tabs {
    display: flex;
    gap: 6px;
    padding: 10px 16px 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .mrk-tabs::-webkit-scrollbar { display: none; }
  .mrk-tab {
    flex-shrink: 0;
    padding: 6px 12px;
    font-size: 11px;
    font-family: var(--font-jp);
    color: var(--ink-tertiary);
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.45);
    border-radius: 999.008px;
    text-decoration: none;
    white-space: nowrap;
  }
  .mrk-tab {
    cursor: pointer;
  }
  .mrk-tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* podium (Top3) */
  .mrk-podium {
    padding: 24px 10px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 6px;
    align-items: flex-end;
  }
  .mrk-pod {
    position: relative;
    min-width: 0;
    text-align: center;
    text-decoration: none;
    color: inherit;
  }
  .mrk-pod-crown {
    display: block;
    margin: 0 auto -4px;
  }
  .mrk-pod-card {
    background: #fff;
    border: 1px solid #e3edf6;
    border-radius: 14px;
    padding: 14px 6px 12px;
    position: relative;
    box-shadow: 0 2px 8px rgba(160, 190, 220, 0.14);
    min-height: 150px;
  }
  .mrk-pod-first .mrk-pod-card {
    border: 2px solid #f5c84a;
    box-shadow: 0 4px 16px rgba(245, 200, 74, 0.25);
    min-height: 170px;
  }
  .mrk-pod-no {
    position: absolute;
    top: -8px;
    left: 50%;
    transform: translateX(-50%);
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--crown);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #fff;
  }
  .mrk-pod-img {
    height: 92px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
  }
  .mrk-pod-img.is-first { height: 110px; }
  .mrk-pod-img :global(.ri) { height: 92px !important; }
  .mrk-pod-img.is-first :global(.ri) { height: 110px !important; }
  .mrk-pod-name {
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-primary);
    margin-top: 8px;
    line-height: 1.3;
    padding: 0 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    word-break: break-word;
  }
  .mrk-pod-card { min-width: 0; }
  .mrk-pod-first .mrk-pod-name { font-size: 12px; }
  .mrk-pod-stars {
    margin-top: 4px;
    display: flex;
    justify-content: center;
  }
  .mrk-pod-pill {
    background: #eaf4fc;
    color: #3d86c4;
    font-size: 9px;
    font-weight: 600;
    padding: 3px 6px;
    border-radius: 999.008px;
    margin: 8px auto 0;
    display: inline-block;
  }

  /* themes */
  .mrk-themes {
    padding: 26px 16px 0;
  }
  .mrk-themes-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 16px;
    color: var(--accent-deeper);
    margin: 0 0 14px;
    line-height: 1;
  }
  .mrk-theme {
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.22);
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    box-shadow: 0 2px 8px rgba(160, 190, 220, 0.1);
  }
  .mrk-theme-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .mrk-theme-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(122, 169, 217, 0.12);
