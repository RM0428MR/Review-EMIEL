<script>
  // Ranking category tabs — switch visible Top3 pane on click
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const btn = target.closest<HTMLButtonElement>('button[data-rk-tab]');
    if (!btn) return;
    const cat = btn.dataset.rkTab ?? '';
    // toggle active on every tab group (desktop .rk-tabs + mobile .mrk-tabs)
    document.querySelectorAll<HTMLElement>('[data-rk-tabs] [data-rk-tab]').forEach((b) => {
      b.classList.toggle('active', b.dataset.rkTab === cat);
    });
    // toggle active on every pane (desktop .top3 + mobile .mrk-podium)
    document.querySelectorAll<HTMLElement>('[data-rk-pane]').forEach((p) => {
      p.classList.toggle('active', p.dataset.rkPane === cat);
    });
  });
</script>
