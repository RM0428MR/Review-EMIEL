---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewImage from '../components/ReviewImage.astro';
import HeartsRating from '../components/HeartsRating.astro';
import BearDoodle from '../components/BearDoodle.astro';
import SpeechBubble from '../components/SpeechBubble.astro';
import Cloud from '../components/Cloud.astro';
import { listReviews } from '../lib/microcms.ts';

const { contents: all } = await listReviews({ orders: '-rating,-date', limit: 100 });
const top3 = all.slice(0, 3);

const themes = [
  {
    title: 'さっぱり系',
    sub: 'ゴクゴク飲める！きっぱりおいしいカルピス',
    icon: '🥤',
    href: '/reviews?mood=さっぱり',
    items: all.filter((r) => r.mood?.includes('さっぱり')).slice(0, 3),
  },
  {
    title: '甘い系',
    sub: '甘くてまろやか！幸せになれる味わい',
    icon: '♡',
    href: '/reviews?mood=甘め,濃厚',
    items: all.filter((r) => r.mood?.includes('甘め') || r.mood?.includes('濃厚')).slice(0, 3),
  },
  {
    title: '夏に飲みたい！',
    sub: '暑い日にぴったりな爽やかカルピス',
    icon: '☀',
    href: '/reviews?season=夏',
    items: all.filter((r) => r.season === '夏').slice(0, 3),
  },
  {
    title: '限定・コラボ',
    sub: '出会えたらラッキー♡特別なカルピスたち',
    icon: '✦',
    href: '/reviews?cat=コラボ,期間限定',
    items: all.filter((r) => r.cat === 'コラボ' || r.cat === '期間限定').slice(0, 3),
  },
];
---
<BaseLayout title="ranking" activeTab="ranking">
  <Header active="ranking" />

  <section class="head">
    <div>
      <h1>ranking <span>♔</span></h1>
      <p>これまで飲んできたカルピスたちの<br />中から、特にお気に入りをランキングにしました！</p>
    </div>
    <div class="bear-bubble">
      <BearDoodle size={70} />
      <SpeechBubble>どの子もおいしくて<br />本当に迷っちゃう…！</SpeechBubble>
    </div>
    <div class="criteria">
      <div class="criteria-h">♔ rankingについて</div>
      <p>評価は「味のおいしさ」「飲みやすさ」「特別感」「リピートしたさ」の4つのポイントをもとに、5.0点満点でつけています。</p>
    </div>
  </section>

  <section class="top3">
    {top3.map((r, i) => (
      <a href={`/reviews/${r.slug}`} class={`tcard ${i === 0 ? 'highlight' : ''}`}>
        <div class="rank-no">No.{i + 1}</div>
        <ReviewImage r={r} variant="card" height={140} />
        <div class="tinfo">
          <h3>カルピス {r.name}</h3>
          <HeartsRating value={r.rating} size={12} />
          <p>{r.oneLiner}</p>
          <div class="tags">
            {(r.tags ?? []).slice(0, 3).map((t) => <span>#{t}</span>)}
          </div>
        </div>
      </a>
    ))}
  </section>

  <section class="themes-wrap">
    <h2>✦ テーマ別ランキング</h2>
    <div class="themes">
      {themes.map((th) => (
        <div class="theme">
          <div class="theme-h"><span class="ico">{th.icon}</span>{th.title}</div>
          <div class="theme-sub">{th.sub}</div>
          {th.items.length === 0 && <div class="empty">該当する商品はまだありません</div>}
          {th.items.map((r, i) => (
            <a href={`/reviews/${r.slug}`} class="trow">
              <span class="rn">{i + 1}</span>
              <ReviewImage r={r} variant="card" height={28} />
              <span class="rname">カルピス {r.name}</span>
              <HeartsRating value={r.rating} size={9} showValue={false} />
            </a>
          ))}
          <a href={th.href} class="more">もっと見る →</a>
        </div>
      ))}
    </div>
  </section>

  <section class="myfav">
    <div class="fav-card">
      <BearDoodle size={60} />
      <div>
        <div class="fav-title">my favorite ♡</div>
        <p>やっぱり、No.1の<br />「カルピス {top3[0]?.name}」が特別！<br />この濃さとコクは唯一無二〜</p>
      </div>
    </div>
    <div class="sns-card">
      <div class="cloud-deco"><Cloud width={120} fill="rgba(255,255,255,0.5)" /></div>
      <p>あなたのおすすめも教えてね！<br />SNSでもカルピス愛を発信中☺</p>
      <div class="sns-icons">
        <span>IG</span><span>X</span><span>YT</span>
      </div>
    </div>
  </section>

  <Footer variant="ranking" />
</BaseLayout>

<style>
.head {
  padding: 0 40px 24px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
  align-items: center;
}
.head h1 { font-family: var(--font-display); font-style: italic; font-size: var(--fs-hero); color: var(--accent); margin: 0; line-height: 1; }
.head h1 span { font-size: 28px; }
.head p { font-size: 12px; margin-top: 8px; color: var(--ink-tertiary); }
.bear-bubble { display: flex; align-items: center; gap: 14px; }
.criteria {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 14px;
  padding: 14px;
}
.criteria-h { font-size: 11px; font-weight: 600; color: var(--accent); margin-bottom: 6px; }
.criteria p { font-size: 11px; line-height: 1.6; color: var(--ink-tertiary); margin: 0; }

.top3 {
  padding: 0 40px 30px;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20px;
}
.tcard {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 18px;
  position: relative;
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 14px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.tcard.highlight { border: 2px solid var(--accent); }
.rank-no {
  position: absolute;
  top: -22px;
  left: 10px;
  font-family: var(--font-display);
  font-size: 36px;
  font-style: italic;
  color: var(--accent);
  font-weight: 700;
  line-height: 1;
}
.tinfo h3 { font-size: 16px; font-weight: 700; color: var(--ink-primary); margin: 0 0 6px; font-family: var(--font-jp); }
.tinfo p { font-size: 11px; line-height: 1.6; margin-top: 8px; color: var(--ink-secondary); }
.tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.tags span { font-size: 9px; color: var(--accent); opacity: 0.75; }

.themes-wrap { padding: 0 40px 30px; }
.themes-wrap h2 { font-size: 14px; font-weight: 600; color: var(--accent); margin-bottom: 14px; font-family: var(--font-jp); }
.themes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.theme {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 14px;
  padding: 14px;
}
.theme-h { font-size: 13px; font-weight: 700; color: var(--ink-primary); font-family: var(--font-jp); }
.theme-h .ico { margin-right: 6px; }
.theme-sub { font-size: 10px; color: var(--ink-tertiary-2); margin: 4px 0 10px; }
.trow {
  display: grid;
  grid-template-columns: 20px 28px 1fr auto;
  gap: 8px;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px dashed rgba(168, 200, 232, 0.3);
  text-decoration: none;
  color: inherit;
}
.rn { font-size: 14px; font-family: var(--font-display); font-style: italic; color: var(--accent); font-weight: 700; }
.rname { font-size: 11px; color: var(--ink-primary); }
.empty { font-size: 11px; color: var(--ink-muted); padding: 12px 0; }
.more {
  display: inline-block;
  margin-top: 8px;
  padding: 4px 12px;
  font-size: 10px;
  background: transparent;
  border: 1px solid var(--accent);
  color: var(--accent);
  border-radius: 999px;
  text-decoration: none;
  font-family: var(--font-jp);
}

.myfav {
  padding: 0 40px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}
.fav-card {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 16px;
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 14px;
  align-items: center;
  position: relative;
}
.fav-title { font-family: var(--font-display); font-style: italic; font-size: 14px; color: var(--accent); }
.fav-card p { font-size: 11px; line-height: 1.6; color: var(--ink-secondary); margin: 6px 0 0; }

.sns-card {
  background: linear-gradient(135deg, #c8e0f3 0%, #eaf4fc 100%);
  border-radius: 18px;
  padding: 16px;
  position: relative;
  display: flex;
  align-items: center;
  gap: 14px;
}
.cloud-deco { position: absolute; top: 0; right: 0; }
.sns-card p { font-size: 12px; color: var(--ink-primary); flex: 1; line-height: 1.6; position: relative; }
.sns-icons { display: flex; gap: 8px; position: relative; }
.sns-icons span {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: var(--accent);
  font-family: var(--font-display);
}

@media (max-width: 768px) {
  .head {
    padding: 0 16px 20px;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .head h1 { font-size: clamp(36px, 9vw, 56px); }
  .bear-bubble { display: none; }
  .top3 {
    padding: 0 16px 24px;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .tcard { grid-template-columns: 80px 1fr; padding: 14px; }
  .themes-wrap { padding: 0 16px 24px; }
  .themes { grid-template-columns: 1fr; }
  .myfav { padding: 0 16px; grid-template-columns: 1fr; }
  body { padding-bottom: 64px; }
}
</style>
