---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDesktop from '../components/contact/Desktop.astro';
import ContactMobile from '../components/contact/Mobile.astro';

const tips = [
  { icon: '♡', label: 'レビューの感想や\nリクエスト' },
  { icon: '◇', label: 'おすすめのエミエル\n情報' },
  { icon: '✉', label: 'お仕事のご依頼・\nコラボのご相談' },
  { icon: '◌', label: 'その他なんでもOK！' },
];
---
<BaseLayout title="contact" activeTab="contact">
  <Header active="contact" />

  <div class="page-desktop">
    <ContactDesktop tips={tips} />
  </div>

  <div class="page-mobile">
    <ContactMobile tips={tips} />
  </div>

  <Footer variant="contact" />
</BaseLayout>

<style>
.page-mobile { display: none; }

@media (max-width: 768px) {
  .page-desktop { display: none; }
  .page-mobile { display: block; }
  body { padding-bottom: 64px; }
}
</style>
