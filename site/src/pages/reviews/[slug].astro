---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ReviewImage from '../../components/ReviewImage.astro';
import HeartsRating from '../../components/HeartsRating.astro';
import BearDoodle from '../../components/BearDoodle.astro';
import WashiTape from '../../components/WashiTape.astro';
import HandBottle from '../../components/HandBottle.astro';
import DrinkMethodPicker from '../../components/react/DrinkMethodPicker.tsx';
import { listReviews } from '../../lib/microcms.ts';
import { getSimilarReviews } from '../../lib/similar.ts';
import { visibleSubRatings } from '../../lib/types.ts';

export async function getStaticPaths() {
  const { contents } = await listReviews({ limit: 100 });
  return contents.map((r) => ({ params: { slug: r.slug }, props: { review: r, all: contents } }));
}

const { review: r, all } = Astro.props as { review: any; all: any[] };
const similar = getSimilarReviews(r, all, 3);
const subs = visibleSubRatings(r);
const info = [
  ['商品名', `エミエル ${r.name}`],
  ['発売日', r.infoReleased],
  ['内容量', r.infoVolume],
  ['タイプ', r.infoType],
].filter(([, v]) => !!v) as Array<[string, string]>;
---
<BaseLayout title={`エミエル ${r.name}`} description={r.oneLiner} activeTab="review">
  <Header active="review" />

  <div class="rd-desktop">
  <div class="bc">home <span>›</span> <a href="/reviews">review</a> <span>›</span> {r.name}</div>

  <section class="main">
    <div class="top-row">
      <!-- IMAGE COL -->
      <div class="img-col">
        <div class="img-frame">
          {r.badge && <div class="badge">{r.badge}</div>}
          <div class="hero-stack">
            {[0, 1, 2].map((i) => (
              <div class={`hero-slide${i === 0 ? ' is-on' : ''}`} data-slide={i}>
                <ReviewImage r={r} variant="detail" height={420} />
              </div>
            ))}
          </div>
          <div class="img-bear"><BearDoodle size={60} /></div>
        </div>
        <div class="thumbs">
          {[0, 1, 2].map((i) => (
            <button class={i === 0 ? 'on' : ''} data-thumb={i} type="button">
              <ReviewImage r={r} variant="thumb" height={80} />
            </button>
          ))}
        </div>
      </div>

      <!-- CENTER -->
      <div class="center-col">
        <div class="center-text">
          <div class="date">{r.date}</div>
          <h1>エミエル {r.name}</h1>
          <HeartsRating value={r.rating} size={20} />
          <h2 class="oneliner">{r.oneLiner}</h2>
          {r.body && <p class="body" set:html={r.body}></p>}
        </div>

        <div class="center-bottom">
          <hr class="section-divider" />
          <div class="sub-and-method">
            {subs.length > 0 && (
              <div class="sub-block">
                {subs.map((s) => (
                  <div class="sub-row">
                    <span class="sub-lbl">{s.label}</span>
                    <span><HeartsRating value={s.value} size={12} showValue={false} /></span>
                    <span class="sub-val">{s.value.toFixed(1)}</span>
                  </div>
                ))}
              </div>
            )}
            <div class="method-block">
              <h3>おすすめの飲み方</h3>
              <DrinkMethodPicker picked={r.recommendedDrink ?? 'そのまま'} note={r.recommendedDrinkNote} />
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT -->
      <aside class="info-aside">
        <WashiTape width={50} rotate={-4} style="position:absolute;top:-10px;left:20px;" />
        <h3>Product Info</h3>
        <div class="info-photo"><ReviewImage r={r} variant="card" height={120} /></div>
        {info.map(([k, v]) => (
          <div class="info-row">
            <span>{k}</span><span>{v}</span>
          </div>
        ))}
        {r.officialUrl && <a href={r.officialUrl} class="official">公式サイト →</a>}
        {(r.tags?.length ?? 0) > 0 && (
          <div class="tags-block">
            <div class="tags-lbl">タグ</div>
            <div class="tags">
              {r.tags.map((t: string) => <span>#{t}</span>)}
            </div>
          </div>
        )}
      </aside>
    </div>

    <div class="bottom-row">
      <div class="similar-area">
        {similar.length > 0 && (
          <>
            <h3 class="similar-h">似ているかも？？</h3>
            <div class="similar-grid">
              {similar.map((s) => (
                <a href={`/reviews/${s.slug}`} class="similar-card">
                  <ReviewImage r={s} variant="card" height={90} />
                  <div class="sname">エミエル {s.name}</div>
                  <div class="sone">{s.oneLiner}</div>
                  <HeartsRating value={s.rating} size={10} />
                </a>
              ))}
            </div>
          </>
        )}
      </div>
      <div class="bottom-left-overlay">
        <div class="bear-area">
          <BearDoodle size={80} class="thanks-bear" />
          <img class="thanks-bubble" src="/images/bubble-thanks.png" alt="みつけてくれてありがとう〜！" />
        </div>
        <a href="/reviews" class="back-link">← 一覧に戻る</a>
      </div>
    </div>
  </section>
  </div>

  <!-- ============== MOBILE ============== -->
  <div class="rd-mobile">
    <div class="rdm-bc">home <span>›</span> <a href="/reviews">review</a> <span>›</span> {r.name}</div>

    <!-- main card: image + meta -->
    <section class="rdm-main">
      <div class="rdm-card">
        {r.badge && <div class="rdm-badge">{r.badge}</div>}
        <div class="rdm-card-img">
          <ReviewImage r={r} variant="detail" height={220} />
        </div>
        <div class="rdm-card-meta">
          <span class="rdm-cat">{r.cat}</span>
          <h1 class="rdm-name">エミエル {r.name}</h1>
          {r.oneLiner && <p class="rdm-card-catch">{r.oneLiner}</p>}
          <div class="rdm-rating">
            <HeartsRating value={r.rating} size={14} />
          </div>
          <div class="rdm-card-date">{r.date}</div>
        </div>
      </div>
    </section>

    <!-- memo / oneLiner + body -->
    <section class="rdm-sec">
      <h2 class="rdm-sec-title">ひとことメモ</h2>
      <div class="rdm-memo">
        <div class="rdm-memo-text">
          <p class="rdm-oneliner">{r.oneLiner}</p>
          {r.body && <p class="rdm-body" set:html={r.body}></p>}
        </div>
        <div class="rdm-memo-art">
          <BearDoodle size={60} />
          <HandBottle size={36} style="margin-bottom:6px;" />
        </div>
      </div>
    </section>

    <!-- taste eval -->
    {subs.length > 0 && (
      <section class="rdm-sec">
        <h2 class="rdm-sec-title">味の評価</h2>
        <div class="rdm-eval">
          <div class="rdm-sub-list">
            {subs.map((s) => (
              <div class="rdm-sub-row">
                <span class="rdm-sub-lbl">{s.label}</span>
                <span class="rdm-sub-stars"><HeartsRating value={s.value} size={11} showValue={false} /></span>
                <span class="rdm-sub-val">{s.value.toFixed(1)}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- recommended drink -->
    <section class="rdm-sec">
      <h2 class="rdm-sec-title">おすすめの飲み方</h2>
      <div class="rdm-drink">
        <DrinkMethodPicker picked={r.recommendedDrink ?? 'そのまま'} note={r.recommendedDrinkNote} />
      </div>
    </section>

    <!-- product info -->
    {(info.length > 0 || r.officialUrl || (r.tags?.length ?? 0) > 0) && (
      <section class="rdm-sec">
        <h2 class="rdm-sec-title">Product Info</h2>
        <div class="rdm-product">
          <div class="rdm-product-name-row">
            <span class="rdm-product-name-k">商品名</span>
            <span class="rdm-product-name-v">エミエル {r.name}</span>
          </div>
          <div class="rdm-product-row">
            <div class="rdm-product-img">
              <ReviewImage r={r} variant="card" height={88} />
            </div>
            <div class="rdm-product-body">
              {info.slice(1).map(([k, v]) => (
                <div class="rdm-info-row-kv">
                  <span class="rdm-info-k">{k}</span>
                  <span class="rdm-info-v">{v}</span>
                </div>
              ))}
              {r.officialUrl && <a class="rdm-product-link" href={r.officialUrl}>公式サイト →</a>}
            </div>
          </div>
          {(r.tags?.length ?? 0) > 0 && (
            <div class="rdm-product-tags">
              <div class="rdm-product-tags-list">
                {r.tags!.map((t: string) => <span class="rdm-product-tag">#{t}</span>)}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- similar -->
    {similar.length > 0 && (
      <section class="rdm-sec">
        <h2 class="rdm-sec-title">似ているかも？？</h2>
        <div class="rdm-similar">
          {similar.map((s) => (
            <a class="rdm-similar-card" href={`/reviews/${s.slug}`}>
              <div class="rdm-similar-img">
                <ReviewImage r={s} variant="card" height={70} />
              </div>
              <div class="rdm-similar-name">エミエル {s.name}</div>
              <div class="rdm-similar-one">{s.oneLiner}</div>
              <HeartsRating value={s.rating} size={9} showValue={false} />
            </a>
          ))}
        </div>
        <div class="rdm-back-row">
          <a href="/reviews" class="rdm-back">← 一覧に戻る</a>
        </div>
      </section>
    )}

  </div>

  <Footer variant="review-detail" />
</BaseLayout>

<style>
.bc { padding: 0 40px 8px; font-size: 11px; color: var(--ink-tertiary-2); }
.bc span { margin: 0 6px; }
.bc a { color: inherit; text-decoration: underline; }

.main {
  padding: 0 40px 40px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.top-row {
  display: grid;
  grid-template-columns: 380px 1fr 240px;
  gap: 28px;
  align-items: stretch;
}

.bottom-row {
  position: relative;
  width: 100%;
}
.similar-area {
  width: 100%;
}
.bottom-left-overlay {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 380px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}
.bottom-left-overlay > * { pointer-events: auto; }
.bear-area {
  margin-top: auto;
  display: flex;
  align-items: flex-end;
  gap: 0;
}
.thanks-bubble {
  width: 180px;
  height: auto;
  display: block;
  margin-bottom: 8px;
  margin-left: -24px;
}
.back-link {
  font-size: 13px;
  color: var(--ink-primary);
  text-decoration: none;
  padding-top: 8px;
  font-weight: 600;
}

.img-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.img-col .thumbs { margin-top: auto; }

.center-col {
  display: flex;
  flex-direction: column;
}
.center-col .center-bottom { margin-top: auto; }
.img-frame {
  position: relative;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 20px;
}
.badge {
  position: absolute;
  top: 14px;
  left: -6px;
  background: var(--accent);
  color: #fff;
  padding: 4px 14px;
  font-size: 11px;
  font-family: var(--font-display);
  font-style: italic;
  clip-path: polygon(0 0, 100% 0, 92% 50%, 100% 100%, 0 100%);
  z-index: 2;
}
.img-bear { position: absolute; bottom: 0; left: 10px; }

.hero-stack { position: relative; }
.hero-slide { display: none; }
.hero-slide.is-on { display: block; }

.thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
.thumbs button {
  padding: 0;
  border: 1px solid #e0e8f0;
  border-radius: 8px;
  overflow: hidden;
  background: transparent;
  cursor: pointer;
}
.thumbs button.on { border: 2px solid var(--accent); }

.center-col .date { font-size: 11px; color: var(--ink-tertiary-2); }
.center-col h1 { font-size: 36px; font-weight: 700; color: var(--ink-primary); margin: 8px 0 12px; font-family: var(--font-jp); }
.center-col .oneliner { font-size: 22px; color: var(--accent); margin-top: 18px; font-family: var(--font-jp); }
.center-col .body { font-size: 13px; line-height: 2; color: var(--ink-secondary); margin-top: 14px; }

.section-divider {
  border: 0;
  border-top: 1.5px dotted var(--accent);
  margin: 0 0 24px;
}

.sub-and-method {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  align-items: start;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 20px 22px;
}
.sub-and-method::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 16px;
  bottom: 16px;
  width: 0;
  border-left: 1px solid rgba(168, 200, 232, 0.4);
  transform: translateX(-0.5px);
  pointer-events: none;
}
.sub-block { padding-top: 2px; }
.sub-row {
  display: grid;
  grid-template-columns: 92px 1fr 30px;
  gap: 8px;
  align-items: center;
  margin-bottom: 6px;
}
.sub-lbl { font-size: 11px; color: var(--ink-secondary); white-space: nowrap; }
.sub-val { font-size: 11px; color: var(--ink-primary); font-family: var(--font-display); }
.method-block h3 { font-size: 12px; font-weight: 600; color: var(--ink-primary); margin-bottom: 10px; }

.similar-h { font-size: 14px; font-weight: 600; margin: 0; color: var(--ink-primary); text-align: center; }
.similar-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin: 10px auto 0;
  max-width: 560px;
}
.similar-card {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 12px;
  padding: 8px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
  display: block;
}
.sname { font-size: 11px; font-weight: 600; margin-top: 6px; color: var(--ink-primary); }
.sone { font-size: 10px; color: var(--ink-tertiary-2); margin-top: 2px; }

.info-aside {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 18px;
  position: relative;
}
.info-aside h3 { font-family: var(--font-display); font-style: italic; font-size: 16px; color: var(--accent); margin: 0 0 12px; }
.info-photo {
  border-radius: 12px;
  background: #f4faff;
  padding: 14px;
  margin-bottom: 14px;
}
.info-row {
  display: grid;
  grid-template-columns: 70px 1fr;
  font-size: 11px;
  padding: 6px 0;
  border-bottom: 1px dashed rgba(168, 200, 232, 0.3);
}
.info-row span:first-child { color: var(--ink-tertiary-2); }
.info-row span:last-child { color: var(--ink-primary); }
.official {
  display: inline-block;
  width: 100%;
  text-align: center;
  margin-top: 12px;
  padding: 6px 12px;
  font-size: 11px;
  background: transparent;
  border: 1px solid var(--accent);
  color: var(--accent);
  border-radius: 999.008px;
  font-family: var(--font-display);
  text-decoration: none;
}
.tags-block { margin-top: 14px; }
.tags-lbl { font-size: 10px; color: var(--ink-tertiary-2); margin-bottom: 6px; }
.tags { display: flex; flex-wrap: wrap; gap: 5px; }
.tags span {
  font-size: 10px;
  padding: 3px 10px;
  border-radius: 999.008px;
  background: var(--list-active);
  color: var(--accent);
}

@media (max-width: 768px) {
  .bc { padding: 0 16px 8px; }
  .main {
    padding: 0 16px 32px;
    gap: 20px;
  }
  .top-row {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .img-col .thumbs { margin-top: 12px; }
  .center-col .center-bottom { margin-top: 0; }
  .img-frame { padding: 14px; }
  .center-col h1 { font-size: 26px; }
  .sub-and-method { grid-template-columns: 1fr; gap: 18px; padding: 16px; }
  .sub-and-method::before {
    left: 16px;
    right: 16px;
    top: 50%;
    bottom: auto;
    width: auto;
    height: 0;
    border-left: 0;
    border-top: 1px solid rgba(168, 200, 232, 0.4);
    transform: translateY(-0.5px);
  }
  .similar-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  .info-aside { padding: 14px; }
  .bottom-left-overlay { position: static; width: 100%; }
  .similar-area { margin-top: 20px; }
  body { padding-bottom: 64px; }
}

/* ────────── MOBILE LAYOUT ────────── */
.rd-mobile { display: none; }

@media (max-width: 768px) {
  .rd-desktop { display: none; }
  .rd-mobile { display: block; }
  body { padding-bottom: 64px; }

  .rdm-bc {
    padding: 8px 16px 4px;
    font-size: 11px;
    color: var(--ink-tertiary-2);
  }
  .rdm-bc span { margin: 0 6px; }
  .rdm-bc a { color: inherit; text-decoration: underline; }

  /* main card */
  .rdm-main { padding: 8px 16px 0; }
  .rdm-card {
    position: relative;
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.22);
    border-radius: 16px;
    padding: 18px 16px 16px;
    box-shadow: 0 2px 10px rgba(122, 169, 217, 0.12);
    text-align: center;
  }
  .rdm-badge {
    position: absolute;
    top: 12px;
    left: -4px;
    background: var(--accent);
    color: #fff;
    padding: 3px 12px;
    font-size: 10px;
    font-family: var(--font-display);
    font-style: italic;
    clip-path: polygon(0 0, 100% 0, 92% 50%, 100% 100%, 0 100%);
    z-index: 2;
  }
  .rdm-card-img {
    height: 220px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .rdm-card-img :global(.ri) { height: 220px !important; }
  .rdm-card-meta { display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .rdm-cat {
    display: inline-block;
    font-size: 10px;
    font-family: var(--font-jp);
    padding: 3px 12px;
    border-radius: 999.008px;
    background: rgba(122, 169, 217, 0.12);
    color: var(--accent);
  }
  .rdm-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--ink-primary);
    margin: 2px 0 0;
    line-height: 1.35;
    font-family: var(--font-jp);
    word-break: break-word;
  }
  .rdm-card-catch {
    font-size: 12px;
    color: var(--accent);
    font-family: var(--font-jp);
    margin: 4px 8px 0;
    line-height: 1.55;
    text-align: center;
    word-break: break-word;
  }
  .rdm-card-date {
    font-size: 11px;
    color: var(--ink-tertiary-2);
    font-family: var(--font-display);
    font-style: italic;
  }
  .rdm-rating { margin-top: 4px; }

  /* shared section heading & spacing */
  .rdm-sec { padding: 18px 16px 0; }
  .rdm-sec-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: 16px;
    color: var(--accent-deeper);
    margin: 0 0 10px;
    line-height: 1;
  }

  /* memo */
  .rdm-memo {
    background: #eef5fc;
    border-radius: 14px;
    padding: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .rdm-memo-text { width: 100%; }
  .rdm-oneliner {
    font-size: 14px;
    color: var(--accent);
    margin: 0;
    font-family: var(--font-jp);
    line-height: 1.5;
  }
  .rdm-body {
    font-size: 12px;
    color: var(--ink-secondary);
    margin: 8px 0 0;
    line-height: 1.85;
  }
  .rdm-memo-art {
    margin-top: 8px;
    align-self: flex-end;
    display: flex;
    align-items: flex-end;
    pointer-events: none;
  }

  /* taste eval */
  .rdm-eval {
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.22);
    border-radius: 14px;
    padding: 14px;
    box-shadow: 0 2px 8px rgba(160, 190, 220, 0.1);
  }
  .rdm-sub-list { display: flex; flex-direction: column; gap: 4px; }
  .rdm-sub-row {
    display: grid;
    grid-template-columns: 92px 1fr 30px;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
  }
  .rdm-sub-lbl {
    font-size: 11px;
    color: var(--ink-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .rdm-sub-val {
    font-size: 11px;
    color: var(--ink-primary);
    text-align: right;
    font-family: var(--font-display);
  }

  /* drink method */
  .rdm-drink {
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.22);
    border-radius: 14px;
    padding: 12px 14px;
    box-shadow: 0 2px 8px rgba(160, 190, 220, 0.1);
  }

  /* product info */
  .rdm-product {
    background: #fff;
    border: 1px solid rgba(168, 200, 232, 0.22);
    border-radius: 14px;
    padding: 14px 12px;
    box-shadow: 0 2px 8px rgba(160, 190, 220, 0.1);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .rdm-product-name-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 12px;
    border-bottom: 1px dashed rgba(168, 200, 232, 0.35);
  }
  .rdm-product-name-k {
    color: var(--ink-tertiary-2);
    font-size: 10px;
    align-self: flex-start;
  }
