---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeDesktop from '../components/home/Desktop.astro';
import HomeMobile from '../components/home/Mobile.astro';
import { listReviews } from '../lib/microcms.ts';
import { CATEGORIES } from '../data/reviews.ts';

const { contents: allReviews, totalCount: totalReviews } = await listReviews({ orders: '-date', limit: 100 });
const top3 = [...allReviews].sort((a, b) => (b.rating - a.rating) || b.date.localeCompare(a.date)).slice(0, 3);

// review セクション用：カテゴリごとの件数（chip クリック時の overflow CTA 表示判定に使用）
const categoryCounts: Record<string, number> = { 'すべて': allReviews.length };
for (const c of CATEGORIES) if (c !== 'すべて') categoryCounts[c] = 0;
for (const r of allReviews) {
  if (categoryCounts[r.cat] != null) categoryCounts[r.cat] += 1;
}
// Home review archive は全件を DOM に出し、client-side chip filter で先頭 10 件 (5 列 × 2 行) のみ表示する。
// 余剰分は「すべて見る →」リンク経由で Archive 画面へ誘導する (overflow CTA は廃止済)。
const archive = allReviews;
const myFavorite = top3[0];

// Home の review archive セクションは Archive 画面との連携が前提。年バケットラベルと URL 値は
// ArchiveBrowser の yearList と一致させる（"2024年" 等）。
const yearChips = ['すべて', '2024年', '2023年', '2022年', '2021年', '2020年', 'それ以前'];

// 年バケット集計：将来の overflow 判定用 (現状は cap 10 を超えた件数把握のメタ情報として保持)
function yearBucketOf(date: string): string {
  const ny = parseInt(date.slice(0, 4));
  if (isNaN(ny)) return 'それ以前';
  if (ny >= 2020 && ny <= 2024) return `${ny}年`;
  return 'それ以前';
}
const archiveBucketCounts: Record<string, number> = {
  'すべて': allReviews.length,
  '2024年': 0, '2023年': 0, '2022年': 0, '2021年': 0, '2020年': 0, 'それ以前': 0,
};
for (const r of allReviews) {
  const b = yearBucketOf(r.date);
  archiveBucketCounts[b] = (archiveBucketCounts[b] ?? 0) + 1;
}

// mobile aggregates
const yearCountMap = new Map<string, number>();
for (const r of allReviews) {
  const y = r.date.slice(0, 4);
  yearCountMap.set(y, (yearCountMap.get(y) ?? 0) + 1);
}
const mYearCounts = Array.from(yearCountMap.entries()).sort(([a], [b]) => b.localeCompare(a)).slice(0, 3);

const monthDataMap = new Map<string, { count: number; latest: string }>();
for (const r of allReviews) {
  const ym = r.date.slice(0, 7).replaceAll('-', '.');
  if (!monthDataMap.has(ym)) monthDataMap.set(ym, { count: 0, latest: r.name });
  monthDataMap.get(ym)!.count += 1;
}
const mMonthTimeline = Array.from(monthDataMap.entries()).sort(([a], [b]) => b.localeCompare(a)).slice(0, 3);

const mNewReviews = allReviews.slice(0, 6);
---
<BaseLayout title="home" description="エミエルを愛しすぎている個人ファンが運営する架空のレビュー日誌サイト" activeTab="home">
  <Header active="home" />

  <div class="page-desktop">
    <HomeDesktop {allReviews} {categoryCounts} {top3} {archive} {myFavorite} {yearChips} {archiveBucketCounts} {CATEGORIES} />
  </div>

  <div class="page-mobile">
    <HomeMobile {mNewReviews} {mYearCounts} {mMonthTimeline} {top3} {totalReviews} />
  </div>

  <Footer variant="home" />
</BaseLayout>

<style>
  .page-mobile { display: none; }
  @media (max-width: 768px) {
    .page-desktop { display: none; }
    .page-mobile { display: block; }
    body { padding-bottom: 64px; }
  }
</style>
