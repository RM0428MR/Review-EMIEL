---
interface Props { active?: string; }
const { active } = Astro.props;
const items = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'review', label: 'Review', href: '/reviews' },
  { id: 'ranking', label: 'Ranking', href: '/ranking' },
  { id: 'archive', label: 'Archive', href: '/archive' },
  { id: 'about', label: 'About', href: '/about' },
  { id: 'contact', label: 'Contact', href: '/contact' },
];
---
<nav class="mtab" aria-label="モバイルナビゲーション">
  {items.map((it) => (
    <a href={it.href} class={`tab ${active === it.id ? 'on' : ''}`}>
      <span class="ico" aria-hidden="true">
        {it.id === 'home' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 3.2 3 11h2v9h5v-6h4v6h5v-9h2z" /></svg>
        )}
        {it.id === 'review' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l4-1 11-11-3-3L4 17l-1 4z" /><path d="M14 6l3 3" /></svg>
        )}
        {it.id === 'ranking' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 8l3.5 4L12 6l5.5 6L21 8v10H3z" /></svg>
        )}
        {it.id === 'archive' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 7a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" /></svg>
        )}
        {it.id === 'about' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 11v5" /><circle cx="12" cy="8" r="0.8" fill="currentColor" stroke="none" /></svg>
        )}
        {it.id === 'contact' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="1.5" /><path d="M3 7l9 7 9-7" /></svg>
        )}
      </span>
      <span class="lbl">{it.label}</span>
    </a>
  ))}
</nav>
<style>
.mtab {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 80;
  background: #fff;
  border-top: 1px solid rgba(168, 200, 232, 0.4);
  padding: 6px 4px calc(6px + env(safe-area-inset-bottom, 0px));
  justify-content: space-around;
  font-family: var(--font-jp);
}
.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 4px 0;
  text-decoration: none;
  color: var(--ink-muted-2);
  flex: 1;
}
.tab.on { color: var(--accent); }
.lbl { font-size: 10px; }
@media (max-width: 768px) {
  .mtab { display: flex; }
}
</style>
