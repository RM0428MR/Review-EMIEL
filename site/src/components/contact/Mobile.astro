---
import BearDoodle from '../BearDoodle.astro';
import ContactForm from '../react/ContactForm.tsx';

interface Tip {
  icon: string;
  label: string;
}

interface Props {
  tips: Tip[];
}

const { tips: _tips } = Astro.props;
---
<div class="cn-mobile">
  <!-- HERO -->
  <section class="mcn-hero">
    <div class="mcn-hero-card">
      <div class="mcn-hero-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d86c4" stroke-width="1.8">
          <rect x="3" y="6" width="18" height="13" rx="1.5" />
          <path d="M3 7l9 7 9-7" />
        </svg>
      </div>
      <div class="mcn-hero-text">
        <h1>Contact</h1>
        <p>お問い合わせ・ご意見</p>
      </div>
      <div class="mcn-hero-art" aria-hidden="true">
        <BearDoodle size={66} />
      </div>
    </div>
  </section>

  <!-- INVITE / FORM -->
  <section class="mcn-form-sec" id="mcn-form">
    <div class="mcn-invite">
      <div class="mcn-invite-art" aria-hidden="true">
        <BearDoodle size={56} />
      </div>
      <div class="mcn-invite-text">
        <div class="mcn-invite-title">ご意見・ご感想をお聞かせください</div>
        <div class="mcn-invite-sub">My EMIEL Review をより良いサイトにするために、<br />みなさまの声をお待ちしています。</div>
      </div>
    </div>
    <div class="mcn-form-card">
      <div class="mcn-form-head">
        <svg class="mcn-form-ico" width="22" height="18" viewBox="0 0 24 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="3" width="20" height="14" rx="2.5" />
          <path d="M3 5l9 7 9-7" />
          <path d="M6 14l3-3M18 14l-3-3" opacity="0.6" />
        </svg>
        <h3>メッセージを送る</h3>
      </div>
      <ContactForm client:load />
    </div>
  </section>

  <!-- SUPPORT -->
  <section class="mcn-support">
    <div class="mcn-support-h">その他のサポート</div>
    <div class="mcn-support-card">
      <a class="mcn-support-row" href="/about">
        <span class="mcn-support-icon">♡</span>
        <span class="mcn-support-label">about（このサイトについて）</span>
        <span class="mcn-opt-chev" aria-hidden="true">›</span>
      </a>
      <a class="mcn-support-row" href="/reviews">
        <span class="mcn-support-icon">◇</span>
        <span class="mcn-support-label">レビュー一覧</span>
        <span class="mcn-opt-chev" aria-hidden="true">›</span>
      </a>
      <a class="mcn-support-row" href="/ranking">
        <span class="mcn-support-icon">★</span>
        <span class="mcn-support-label">ランキング</span>
        <span class="mcn-opt-chev" aria-hidden="true">›</span>
      </a>
    </div>
  </section>
</div>

<style>
.cn-mobile section { padding: 0; }

/* HERO */
.mcn-hero { padding: 14px 16px 0; }
.mcn-hero-card {
  background: #fff;
  border-radius: 14px;
  padding: 16px 16px 14px;
  box-shadow: 0 2px 8px rgba(160, 190, 220, 0.14);
  display: grid;
  grid-template-columns: 44px 1fr auto;
  gap: 12px;
  align-items: flex-start;
  position: relative;
  overflow: hidden;
}
.mcn-hero-icon {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #eaf4fc;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mcn-hero-text h1 {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
  font-size: 26px;
  color: #1f5fa8;
  line-height: 1;
  margin: 0;
}
.mcn-hero-text p {
  font-size: 11px;
  color: var(--ink-tertiary-2);
  margin: 4px 0 0;
  font-family: var(--font-jp);
}
.mcn-hero-art {
  display: flex;
  align-items: flex-end;
  gap: 0;
}
.mcn-hero-heart {
  color: #f5a3a3;
  font-size: 16px;
  margin-bottom: 30px;
}

/* OPTIONS */
.mcn-options {
  margin: 14px 16px 0;
  background: #fff;
  border-radius: 14px;
  padding: 4px 0;
  box-shadow: 0 2px 8px rgba(160, 190, 220, 0.14);
}
.mcn-opt-row {
  display: grid;
  grid-template-columns: 40px 1fr 18px;
  gap: 12px;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #f0f5fa;
  text-decoration: none;
  color: inherit;
}
.mcn-opt-row:last-child { border-bottom: none; }
.mcn-opt-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: #eaf4fc;
  color: #3d86c4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-family: var(--font-jp);
}
.mcn-opt-label {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink-primary);
  font-family: var(--font-jp);
}
.mcn-opt-sub {
  font-size: 10px;
  color: var(--ink-tertiary-2);
  margin-top: 2px;
  line-height: 1.5;
  font-family: var(--font-jp);
}
.mcn-opt-chev {
  color: #9bbedc;
  font-size: 16px;
  line-height: 1;
  text-align: center;
}

/* INVITE + FORM */
.cn-mobile .mcn-form-sec { padding: 14px 24px 0; }
.mcn-invite {
  background: #eaf4fc;
  border: 1px solid rgba(168, 200, 232, 0.3);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  box-shadow: 0 2px 10px rgba(122, 169, 217, 0.1);
}
.mcn-invite-text {
  flex: 1;
  min-width: 0;
}
.mcn-invite-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink-primary);
  font-family: var(--font-jp);
}
.mcn-invite-sub {
  font-size: 11px;
  color: var(--ink-tertiary-2);
  margin-top: 6px;
  line-height: 1.6;
  font-family: var(--font-jp);
}
.mcn-invite-art {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
.mcn-form-card {
  margin-top: 12px;
  background: #fff;
  border-radius: 14px;
  padding: 14px 16px 12px;
  box-shadow: 0 2px 8px rgba(160, 190, 220, 0.14);
}
.mcn-form-head {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 10px;
  margin-bottom: 14px;
  border-bottom: 1px dashed rgba(122, 169, 217, 0.35);
}
.mcn-form-ico {
  color: var(--accent);
  flex-shrink: 0;
}
.mcn-form-head h3 {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
  font-size: 18px;
  color: var(--accent-deeper);
  margin: 0;
  line-height: 1;
  letter-spacing: 0.3px;
}
/* override the embedded ContactForm grid for narrow screens */
.mcn-form-card :global(.row) {
  grid-template-columns: 1fr;
  gap: 6px;
}
.mcn-form-card :global(label) { padding-top: 0; }
/* shrink submit button & prevent wrap on mobile */
.mcn-form-card :global(.actions) {
  text-align: center;
  margin-top: 12px;
}
.mcn-form-card :global(button[type="submit"]) {
  padding: 8px 28px !important;
  font-size: 13px !important;
  white-space: nowrap !important;
  width: auto !important;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* SUPPORT */
.cn-mobile .mcn-support { padding: 18px 24px 20px; }
.mcn-support-h {
  font-size: 11px;
  color: var(--ink-tertiary-2);
  padding: 0 4px 8px;
  font-family: var(--font-jp);
}
.mcn-support-card {
  background: #fff;
  border: 1px solid rgba(168, 200, 232, 0.22);
  border-radius: 14px;
  padding: 4px 0;
  box-shadow: 0 2px 10px rgba(122, 169, 217, 0.1);
}
.mcn-support-row {
  display: grid;
  grid-template-columns: 24px 1fr 18px;
  gap: 12px;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid #f0f5fa;
  text-decoration: none;
  color: inherit;
}
.mcn-support-row:last-child { border-bottom: none; }
.mcn-support-icon {
  font-size: 14px;
  color: var(--accent);
  text-align: center;
}
.mcn-support-label {
  font-size: 12px;
  color: var(--ink-primary);
  font-family: var(--font-jp);
}
</style>
