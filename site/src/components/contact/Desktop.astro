---
import BearDoodle from '../BearDoodle.astro';
import Underline from '../Underline.astro';
import ContactForm from '../react/ContactForm.tsx';

interface Tip {
  icon: string;
  label: string;
}

interface Props {
  tips: Tip[];
}

const { tips } = Astro.props;
---
<section class="contact">
  <div class="head">
    <div class="head-l">
      <BearDoodle size={80} style="transform: translateY(16px);" />
      <div>
        <h1>contact</h1>
        <p>お問い合わせ・ご感想・お仕事のご依頼など<br />こちらからお気軽にどうぞ！</p>
      </div>
    </div>
    <div class="head-c">
      <div class="head-bottle-group">
        <img src="/images/bubble-contact.png" alt="メッセージ、とってもうれしいです！待ってるよ〜" class="head-bubble" />
        <img src="/images/hand-bottle.png" alt="" class="head-bottle" />
      </div>
    </div>
  </div>

  <div class="form-wrap">
    <div class="form-col">
      <div class="form-head">
        <span class="ico">✉</span>
        <h3>メッセージを送る</h3>
      </div>
      <ContactForm client:load />
    </div>
    <div class="tip-col">
      <div class="tip-h">こんなメッセージも<br />待ってます！</div>
      {tips.map((it) => (
        <div class="tip-row">
          <span class="tip-icon">{it.icon}</span>
          <span class="tip-label">{it.label}</span>
        </div>
      ))}
      <div class="tip-bear">
        <div class="tip-bear-inner">
          <img src="/images/bear-sitting.png" alt="" width="80" height="67" />
          <svg class="tip-bear-heart" viewBox="0 0 30 28" aria-hidden="true">
            <path d="M15 25 C3 17 1 9 6 5 C10 2 14 5 15 8 C16 5 20 2 24 5 C29 9 27 17 15 25 Z"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <aside class="about-side">
    <div class="about-avatar">
      <img src="/images/about-me.png" alt="" width="84" height="84" />
    </div>
    <div class="about-chip">
      about me
      <Underline width={70} color="var(--accent-soft)" style="display:block;margin:4px auto 0;" />
    </div>
    <p class="about-body">
      エミエルがだいすきな<br />
      ごく普通のサラリーマン。<br />
      新商品から期間限定まで、<br />
      いろんなエミエルを飲んで<br />
      正直レビューしてます☺
    </p>
    <a href="/about" class="about-cta">view more →</a>
  </aside>
</section>

<style>
.contact {
  padding: 0 40px 30px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 260px;
  grid-template-rows: auto auto;
  column-gap: 28px;
  row-gap: 24px;
  align-items: start;
}

.head {
  grid-column: 1 / -1;
  grid-row: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: center;
}
.form-wrap { grid-column: 1; grid-row: 2; }
.about-side { grid-column: 2; grid-row: 2; }
.head-l { display: flex; align-items: center; gap: 14px; }
.head h1 { font-family: var(--font-display); font-style: italic; font-size: var(--fs-h1); color: var(--accent); margin: 0; line-height: 1; }
.head p { font-size: 11px; margin-top: 10px; line-height: 1.7; color: var(--ink-secondary); font-family: var(--font-jp); }
.head-c { text-align: center; }
.head-bottle-group {
  position: relative;
  display: inline-block;
  padding-left: 240px;
  /* 吹き出しを tip-col の上方向にさらに右寄せ */
  transform: translateX(calc(-31.25vw + 440px));
}
.head-bubble {
  position: absolute;
  top: -28px;
  left: 28px;
  width: 200px;
  height: auto;
  pointer-events: none;
  user-select: none;
}
.head-bottle {
  width: 48px;
  height: auto;
  display: block;
  position: relative;
  z-index: 2;
  left: -14px;
  top: 20px;
}

.form-wrap {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 14px 22px 12px;
  display: grid;
  /* form-col : tip-col = 3 : 1 (form-col 75%) */
  grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
  gap: 0;
  position: relative;
  /* form-wrap 右辺をさらに左寄せ */
  max-width: calc(50vw + 80px);
}
.form-col {
  padding-right: 22px;
  display: flex;
  flex-direction: column;
}
.form-head {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-bottom: 8px;
  margin-bottom: 10px;
  border-bottom: 1.5px dashed rgba(122, 169, 217, 0.5);
}
.form-head .ico { font-size: 18px; color: var(--accent); }
.form-head h3 { font-family: var(--font-display); font-style: italic; font-size: 16px; color: var(--ink-primary); margin: 0; }

.tip-col {
  padding-left: 22px;
  border-left: 1.5px dashed rgba(122, 169, 217, 0.5);
}
.tip-h {
  font-size: 13px;
  font-weight: 600;
  color: var(--ink-primary);
  font-family: var(--font-jp);
  text-align: center;
  padding-bottom: 6px;
  margin-bottom: 8px;
  border-bottom: 1.5px dashed rgba(122, 169, 217, 0.5);
}
.tip-row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
}
.tip-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-deeper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-family: var(--font-jp);
  flex-shrink: 0;
}
.tip-label { font-size: 11px; color: var(--ink-secondary); white-space: pre-line; font-family: var(--font-jp); line-height: 1.6; }
.tip-bear {
  display: flex;
  justify-content: center;
  margin-top: 6px;
}
.tip-bear-inner {
  position: relative;
  display: inline-block;
}
.tip-bear-inner img {
  width: 80px;
  height: auto;
  display: block;
}
.tip-bear-heart {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 14px;
  height: auto;
  color: #5a89c7;
  transform: rotate(12deg);
}

/* about-side: home の .hero-r と同じスタイル */
.about-side {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 20px;
  padding: 14px 18px 14px;
  position: relative;
  box-shadow: var(--shadow-card);
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 8px;
  /* 上辺を head 領域に向けてさらに上へ */
  margin-top: -80px;
}
.about-avatar {
  width: 84px;
  height: 84px;
  border-radius: 50%;
  background: var(--list-active);
  overflow: hidden;
  flex-shrink: 0;
}
.about-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.about-chip {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 22px;
  color: var(--accent);
  line-height: 1;
}
.about-body {
  font-size: 12px;
  line-height: 1.7;
  color: var(--ink-secondary);
  font-family: var(--font-jp);
  margin: 0;
}
.about-cta {
  display: inline-block;
  margin-top: auto;
  padding: 6px 22px;
  font-size: 13px;
  background: transparent;
  border: 1.2px solid var(--accent);
  color: var(--accent);
  border-radius: 999.008px;
  font-family: var(--font-display);
  font-style: italic;
  text-decoration: none;
}
.about-cta:hover { background: var(--list-active); }
</style>
