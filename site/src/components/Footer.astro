---
import CloudWave from './CloudWave.astro';
import SocialIcon from './SocialIcon.astro';

interface Props {
  variant?: 'home' | 'review-list' | 'review-detail' | 'ranking' | 'archive' | 'contact' | 'about';
}
const { variant = 'home' } = Astro.props;
const items = ['home', 'about', 'review', 'ranking', 'archive', 'contact'];
const hrefMap: Record<string, string> = {
  home: '/', about: '/about', review: '/reviews', ranking: '/ranking', archive: '/archive', contact: '/contact',
};
// shared footer (cloud wave + decorations + nav + copyright) is rendered on every variant.
// 旧 review-list 変種は pagination 用の portal target を出していたが、
// pagination は ReviewFilters の scope ([data-rf-scope]) 配下に移したため不要。
// variant prop は呼び出し側の互換のために受け取るだけで、振る舞いは shared のみ。
const isShared = true;
---
{variant === 'review-detail' && (
  <footer class="rd"></footer>
)}

{isShared && (
  <footer class="shared">
    <div class="wave-wrap wave-desktop" aria-hidden="true">
      <CloudWave fill="var(--cloud-soft)" />
    </div>
    <div class="wave-wrap wave-mobile" aria-hidden="true">
      <CloudWave fill="var(--cloud-soft)" step={160} lift={26} />
    </div>

    <div class="band">
      <div class="dots" aria-hidden="true">
        <span class="dot d1"></span>
        <span class="dot d2"></span>
        <span class="dot d3"></span>
        <span class="dot d4"></span>
        <span class="dot d5"></span>
        <span class="dot d6"></span>
        <span class="dot d7"></span>
        <span class="dot d8"></span>
        <span class="dot d9"></span>
        <span class="dot d10"></span>
      </div>

      <nav class="nav-row">
        {items.map((x, i) => (
          <>
            <a href={hrefMap[x]}>{x}</a>
            {i < items.length - 1 && <span class="sep">|</span>}
          </>
        ))}
      </nav>
      <div class="copy">© 2026 my EMIEL diary review</div>
    </div>

    {/* art layer: rendered above wave + band so nothing is clipped */}
    <div class="art-layer" aria-hidden="true">
      <img class="art bottle" src="/images/footer-bottle.png" alt="" />
      <img class="art bubble bubble-l" src="/images/footer-bubble-thanks.png" alt="いつも見てくれてありがとう〜！" />
      <img class="art bear" src="/images/footer-bear.png" alt="" />
      <div class="socials">
        <SocialIcon kind="ig" size={42} />
        <SocialIcon kind="x" size={42} />
        <SocialIcon kind="cup" size={42} />
      </div>
      <img class="art bubble bubble-r" src="/images/footer-bubble-yoroshiku.png" alt="これからもよろしくね！" />
      <img class="art cup" src="/images/footer-cup.png" alt="" />
    </div>
  </footer>
)}

<style>
footer { position: relative; margin-top: 24px; }

/* ============ review-detail spacer ============ */
footer.rd { height: 24px; margin-top: 0; }

/* ============ shared footer ============ */
footer.shared {
  position: relative;
  margin-top: 100px;            /* room for the bear above the wave */
  overflow-x: clip;             /* no horizontal scroll from dots */
}
/* wave acts as a backdrop only */
.wave-wrap {
  position: relative;
  z-index: 1;
  pointer-events: none;
}
.wave-mobile { display: none; }

.shared .band {
  position: relative;
  z-index: 2;
  background: var(--cloud-soft);
  padding: 48px 56px 18px;      /* socials end ~120px from footer top; band starts here, gap before nav */
  color: var(--ink-primary);
  font-family: var(--font-jp);
}

/* polka dots scattered on the cloud + above */
.dots { position: absolute; inset: -60px 0 0; pointer-events: none; z-index: 3; }
.dot {
  position: absolute;
  border-radius: 50%;
  background: var(--accent-soft);
  opacity: 0.55;
}
.dot.d1  { width: 10px; height: 10px; top: 12px;  left: 18%; }
.dot.d2  { width: 6px;  height: 6px;  top: 70px;  left: 27%; opacity: 0.4; }
.dot.d3  { width: 8px;  height: 8px;  top: 18px;  left: 38%; }
.dot.d4  { width: 6px;  height: 6px;  top: 110px; left: 47%; opacity: 0.45; }
.dot.d5  { width: 8px;  height: 8px;  top: 28px;  left: 56%; }
.dot.d6  { width: 5px;  height: 5px;  top: 90px;  left: 64%; opacity: 0.5; }
.dot.d7  { width: 8px;  height: 8px;  top: 8px;   left: 72%; }
.dot.d8  { width: 6px;  height: 6px;  top: 100px; left: 78%; opacity: 0.45; }
.dot.d9  { width: 9px;  height: 9px;  top: 30px;  left: 86%; }
.dot.d10 { width: 6px;  height: 6px;  top: 78px;  left: 12%; opacity: 0.4; }

/* art layer overlays the wave + band area */
.art-layer {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
}
.art {
  position: absolute;
  display: block;
  height: auto;
  user-select: none;
  -webkit-user-drag: none;
}

/* bottle: straddles the wave/band boundary on the left, leaning left */
.bottle {
  width: 108px;
  left: 4%;
  top: -38px;
  transform: rotate(-30deg);
}

/* left bubble (sits closer to the bottle, lifted up) */
.bubble-l {
  width: 168px;
  left: 10%;
  top: -44px;
  transform: rotate(-3deg);
}

/* center bear: sits at the wave/band boundary, larger */
.bear {
  width: 276px;
  left: 50%;
  transform: translateX(-50%);
  top: -56px;
}

/* right bubble (sits closer to the cup, lifted up) */
.bubble-r {
  width: 168px;
  right: 10%;
  top: -28px;
  transform: rotate(3deg);
}

/* cup: straddles the wave/band boundary on the right */
.cup {
  width: 100px;
  right: 4%;
  top: -28px;
  transform: rotate(4deg);
}

/* socials live INSIDE the band area, under the bear */
.socials {
  position: absolute;
  z-index: 11;
  left: 50%;
  transform: translateX(-50%);
  top: 78px;             /* lower position under the bear */
  display: flex;
  gap: 18px;
  pointer-events: auto;
}
.socials :global(.si) {
  border: 1px solid var(--accent-soft) !important;
  box-shadow: 0 1px 2px rgba(122, 169, 217, 0.12);
}

/* nav + copyright sit at the bottom of the band */
.nav-row {
  position: relative;
  z-index: 4;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 22px;
  font-size: 14px;
  font-family: var(--font-display);
  font-style: italic;
  color: var(--accent-deeper);
  margin-top: 4px;
}
.nav-row a {
  text-decoration: none;
  color: inherit;
  letter-spacing: 0.04em;
}
.nav-row a:hover { opacity: 0.7; }
.sep { color: var(--accent); opacity: 0.6; }

.copy {
  position: relative;
  z-index: 4;
  text-align: center;
  font-family: var(--font-display);
  font-style: italic;
  font-size: 13px;
  color: var(--accent-deeper);
  margin-top: 10px;
  opacity: 0.85;
}

/* ============ desktop large ============ */
@media (min-width: 1280px) {
  .bottle    { left: 5%; }
  .bubble-l  { left: 11%; }
  .bubble-r  { right: 11%; }
  .cup       { right: 5%; }
}

/* ============ medium ============ */
@media (max-width: 1100px) {
  .bottle    { width: 88px; left: 2%; top: -28px; }
  .bubble-l  { width: 144px; left: 8%; top: -22px; }
  .bear      { width: 230px; top: -42px; }
  .bubble-r  { width: 144px; right: 8%; top: -22px; }
  .cup       { width: 84px; right: 2%; top: -18px; }
  .socials   { top: 70px; }
}

/* ============ mobile ============ */
@media (max-width: 760px) {
  footer.shared { margin-top: 50px; }
  .wave-desktop { display: none; }
  .wave-mobile { display: block; }
  .shared .band { padding: 44px 16px 18px; margin-top: -8px; }
  /* hide bottle / cup on mobile — too crowded */
  .bottle, .cup { display: none; }
  .bubble-l  { width: 96px; left: 2%; top: 14px; }
  .bear      { width: 130px; top: 6px; }
  .bubble-r  { width: 96px; right: 2%; top: 14px; }
  .socials   { top: 94px; gap: 12px; }
  .socials :global(.si) {
    width: 32px !important; height: 32px !important;
  }
  .nav-row { flex-wrap: wrap; gap: 8px 12px; font-size: 13px; }
  .copy { font-size: 12px; padding: 0 8px; }
}
</style>
