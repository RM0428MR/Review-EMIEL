---
import ReviewImage from '../ReviewImage.astro';
import BearDoodle from '../BearDoodle.astro';
import { getMonth, archiveYearBucket } from '../../lib/format.ts';

interface Props {
  all: any[];
  totalCount: number;
  buckets: Map<string, any[]>;
  yearOrder: string[];
  yearList: string[];
}

const { all, totalCount, buckets, yearOrder, yearList } = Astro.props;
const yearCount = (y: string) => (y === 'すべての年代' ? all.length : buckets.get(y)?.length ?? 0);
---
<section class="ar-m-head">
  <div class="ar-m-title-row">
    <svg class="ar-m-icon" width="26" height="22" viewBox="0 0 26 22" fill="none" stroke="currentColor" stroke-width="1.7">
      <path d="M2 6a2 2 0 012-2h6l2 2h10a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V6z" stroke-linejoin="round"/>
    </svg>
    <div class="ar-m-title-text">
      <h1>archive</h1>
      <p>これまでにレビューしたエミエルたちを<br />年ごとにまとめています。</p>
    </div>
    <div class="ar-m-count">
      <span class="ar-m-count-num">{totalCount}</span>
      <span class="ar-m-count-unit">種類</span>
    </div>
  </div>
</section>

<!-- year filter pills (drives the same data-archive-year handlers) -->
<div class="ar-m-pills">
  {yearList.map((y) => (
    <button type="button" class={`ar-m-pill ${y === 'すべての年代' ? 'on' : ''}`} data-archive-year={y}>
      {y}<span class="ar-m-pill-cnt">{yearCount(y)}</span>
    </button>
  ))}
</div>

<div class="ar-m-bar">
  <span class="ar-m-bar-count">全 {totalCount}件のレビュー</span>
  <span class="ar-m-bar-sort">新しい順</span>
</div>

<!-- year-grouped list (mobile is year-only — month toggle omitted for simplicity).
     data-archive-section / data-archive-section-count を付けて ArchiveBrowser から
     desktop と同じ規約で扱えるようにする（年フィルタ時の空セクション抑止と件数更新）。 -->
<div class="ar-m-list">
  {yearOrder.map((y) => (
    <div class="ar-m-ysec" data-archive-section>
      <div class="ar-m-ysec-head">
        {y === 'それ以前' ? (
          <span class="ar-m-ysec-prev">それ以前</span>
        ) : (
          <span class="ar-m-ysec-year">{y.replace('年', '')}</span>
        )}
        <span class="ar-m-ysec-cnt" data-archive-section-count>{(buckets.get(y) ?? []).length}件</span>
      </div>
      <div class="ar-m-cards">
        {(buckets.get(y) ?? []).map((r) => (
          <a class="ar-m-card" href={`/reviews/${r.slug}`} data-archive-card data-year={archiveYearBucket(r.date)}>
            <div class="ar-m-card-img">
              <ReviewImage r={r} variant="card" height={70} />
            </div>
            <div class="ar-m-card-body">
              <div class="ar-m-card-month">{getMonth(r.date)}月</div>
              <div class="ar-m-card-name">エミエル {r.name}</div>
              <div class="ar-m-card-date">{r.date}</div>
            </div>
            <span class="ar-m-card-chev">›</span>
          </a>
        ))}
      </div>
    </div>
  ))}
</div>

<!-- growing CTA -->
<div class="ar-m-cta">
  <div class="ar-m-cta-card">
    <div class="ar-m-cta-bear">
      <BearDoodle size={64} />
    </div>
    <div class="ar-m-cta-text">
      <div class="ar-m-cta-title">まだまだアーカイブが増えます！</div>
      <div class="ar-m-cta-sub">いろんなエミエルのレビューを<br />記録して、思い出のアーカイブを<br />育てていきましょう。</div>
    </div>
  </div>
</div>

<style>
/* head */
.ar-m-head {
  padding: 14px 16px 6px;
  position: relative;
}
.ar-m-title-row {
  display: grid;
  grid-template-columns: 26px 1fr auto;
  gap: 10px;
  align-items: flex-start;
}
.ar-m-icon { color: var(--accent); margin-top: 2px; }
.ar-m-title-text h1 {
  font-family: var(--font-display);
  font-style: italic;
  font-size: clamp(36px, 9vw, 50px);
  color: var(--accent);
  margin: 0;
  line-height: 1;
}
.ar-m-title-text p {
  font-size: 11px;
  color: var(--ink-tertiary);
  margin-top: 6px;
  line-height: 1.5;
}
.ar-m-count {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 12px;
  padding: 8px 14px;
  text-align: center;
  align-self: center;
  line-height: 1;
}
.ar-m-count-num {
  display: block;
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 700;
  color: var(--accent);
}
.ar-m-count-unit {
  display: block;
  font-size: 9px;
  color: var(--ink-tertiary-2);
  margin-top: 4px;
}
/* year filter pills */
.ar-m-pills {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 14px 16px 4px;
  scrollbar-width: none;
}
.ar-m-pills::-webkit-scrollbar { display: none; }
.ar-m-pill {
  flex-shrink: 0;
  padding: 6px 14px;
  font-size: 12px;
  font-family: var(--font-jp);
  color: var(--ink-tertiary);
  background: #fff;
  border: 1px solid rgba(168, 200, 232, 0.45);
  border-radius: 999.008px;
  white-space: nowrap;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: background 0.15s ease, color 0.15s ease;
}
.ar-m-pill:hover:not(.on) { background: rgba(122, 169, 217, 0.12); }
.ar-m-pill.on {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}
.ar-m-pill-cnt {
  font-size: 10px;
  opacity: 0.8;
}

/* sort/count bar */
.ar-m-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px 0;
}
.ar-m-bar-count { font-size: 11px; color: var(--ink-tertiary); }
.ar-m-bar-sort {
  font-size: 11px;
  color: var(--accent);
  font-family: var(--font-jp);
}

/* year sections */
.ar-m-list {
  padding: 12px 16px 16px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.ar-m-ysec {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ar-m-ysec-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 4px;
  border-bottom: 1px dashed rgba(168, 200, 232, 0.5);
}
.ar-m-ysec-year {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 700;
  font-size: 26px;
  color: var(--accent);
  line-height: 1;
  letter-spacing: 1px;
}
.ar-m-ysec-prev {
  font-family: var(--font-jp);
  font-size: 16px;
  color: var(--ink-secondary);
  font-weight: 600;
}
.ar-m-ysec-cnt {
  font-size: 11px;
  color: var(--accent);
  font-family: var(--font-display);
  font-style: italic;
}

/* mobile cards */
.ar-m-cards {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ar-m-card {
  position: relative;
  background: #fff;
  border: 1px solid rgba(168, 200, 232, 0.22);
  border-radius: 14px;
  padding: 8px 12px;
  box-shadow: 0 2px 10px rgba(122, 169, 217, 0.1);
  display: grid;
  grid-template-columns: 56px minmax(0, 1fr) 14px;
  gap: 10px;
  align-items: center;
  text-decoration: none;
  color: inherit;
}
.ar-m-card-img {
  height: 70px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  overflow: hidden;
}
.ar-m-card-img :global(.ri) { height: 70px !important; }
.ar-m-card-body { min-width: 0; }
.ar-m-card-month {
  display: inline-block;
  font-size: 9px;
  font-family: var(--font-jp);
  padding: 2px 8px;
  border-radius: 999.008px;
  background: rgba(122, 169, 217, 0.12);
  color: var(--accent);
  font-weight: 600;
}
.ar-m-card-name {
  font-size: 13px;
  font-weight: 700;
  color: var(--ink-primary);
  margin-top: 4px;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ar-m-card-date {
  font-size: 10px;
  color: var(--ink-tertiary-2);
  margin-top: 3px;
}
.ar-m-card-chev {
  color: #9bbedc;
  font-size: 16px;
  line-height: 1;
  text-align: center;
}

/* CTA */
.ar-m-cta {
  padding: 0 16px 24px;
}
.ar-m-cta-card {
  background: #eef5fc;
  border: 1.5px dashed #b8d4ec;
  border-radius: 14px;
  padding: 14px 16px;
  display: grid;
  grid-template-columns: 80px 1fr;
  gap: 10px;
  align-items: center;
}
.ar-m-cta-bear {
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.ar-m-cta-title {
  font-size: 12px;
  font-weight: 700;
  color: #3d86c4;
  margin-bottom: 4px;
}
.ar-m-cta-sub {
  font-size: 11px;
  color: var(--ink-tertiary);
  line-height: 1.55;
}
</style>
