---
interface Props { filled?: boolean; size?: number; color?: string; }
const { filled = true, size = 16, color = 'var(--accent)' } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
  <path
    d="M12 21s-7-4.5-9.5-9C.5 8 3 4 7 4c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6.5 4 4.5 8C19 16.5 12 21 12 21z"
    fill={filled ? color : 'none'}
    stroke={color}
    stroke-width="1.6"
    stroke-linejoin="round"
  />
</svg>
