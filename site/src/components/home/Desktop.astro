---
import ReviewCard from '../ReviewCard.astro';
import ReviewImage from '../ReviewImage.astro';
import HeartsRating from '../HeartsRating.astro';
import BearDoodle from '../BearDoodle.astro';
import Underline from '../Underline.astro';
import Star from '../Star.astro';
import type { Review } from '../../lib/types';

interface Props {
  allReviews: Review[];
  categoryCounts: Record<string, number>;
  top3: Review[];
  archive: Review[];
  myFavorite: Review;
  yearChips: string[];
  archiveBucketCounts: Record<string, number>;
  CATEGORIES: readonly string[] | string[];
}

// categoryCounts / archiveBucketCounts は overflow CTA 削除に伴い未使用。Props 型の契約は維持。
const { allReviews, top3, archive, myFavorite, yearChips, CATEGORIES } = Astro.props;

function yearBucketOf(date: string): string {
  const ny = parseInt(date.slice(0, 4));
  if (isNaN(ny)) return 'それ以前';
  if (ny >= 2020 && ny <= 2024) return `${ny}年`;
  return 'それ以前';
}
---
  <!-- HERO -->
  <section class="hero">
    <div class="hero-l">
      <div class="hero-my">my <Star size={10} style="vertical-align:middle;margin-left:4px;" /></div>
      <div class="hero-jp"><span class="hero-jp-main">エミエル</span><span class="hero-diary">diary</span></div>
      <div class="hero-rev">review</div>
      <Underline width={160} style="margin-top:6px;" />
      <p class="hero-lead">
        エミエルがだいすきなぼくの<br />
        エミエルレビュー記録サイト
      </p>
      <div class="hero-decor">
        <Star size={9} color="var(--accent)" />
        <Star size={11} color="var(--accent-soft)" />
        <Star size={8} color="var(--accent)" />
      </div>
    </div>
    <div class="hero-c">
      <div class="hero-photo">
        <img class="hero-photo-img" src="/images/Emiel-main-image.png" alt="" />
      </div>
      <div class="hero-bear"><BearDoodle size={86} /></div>
    </div>
    <div class="hero-r">
      <div class="about-avatar"><img src="/images/about-me.png" alt="" width="110" height="110" style="width:110px;height:110px;object-fit:cover;display:block;border-radius:50%;" /></div>
      <div class="about-chip">
        about me
        <Underline width={70} color="var(--accent-soft)" style="display:block;margin:4px auto 0;" />
      </div>
      <p class="about-body">
        エミエルがだいすきな<br />
        ごく普通のサラリーマン。<br />
        新商品から期間限定まで、<br />
        いろんなエミエルを飲んで<br />
        正直レビューしてます☺
      </p>
      <a href="/about" class="about-cta">view more →</a>
    </div>
  </section>

  <!-- REVIEW -->
  <section class="new-review">
    <div class="section-head">
      <h2>
        <Star size={11} color="var(--accent)" style="margin-right:6px;" />
        review
        <Underline width={70} style="display:block;margin-top:2px;" />
      </h2>
      <div class="chips" data-nr-chips>
        {CATEGORIES.map((c, i) => (
          <button type="button" data-cat={c} class={`chip ${i === 0 ? 'active' : ''}`}>{c}</button>
        ))}
      </div>
      <a class="more" href="/archive">すべて見る →</a>
    </div>
    <div class="card-grid-5" data-nr-grid>
      {allReviews.map((r) => (
        <div class="review-cell" data-nr-card data-cat={r.cat}>
          <ReviewCard r={r} />
        </div>
      ))}
    </div>
  </section>

  <!-- RANKING -->
  <section class="ranking">
    <div class="ranking-l">
      <h2>
        <span class="crown">♔</span>
        ranking
        <Star size={11} color="var(--accent-soft)" style="margin-left:6px;" />
      </h2>
      <div class="rank-grid">
        {top3.map((r, i) => (
          <a href={`/reviews/${r.slug}`} class={`rank-card r-${i + 1}`}>
            <div class="rank-no">No.{i + 1}</div>
            <ReviewImage r={r} variant="card" height={150} />
            <div class="rank-rating"><HeartsRating value={r.rating} size={12} /></div>
            <div class="rank-name">『{r.name}』</div>
            <p class="rank-oneliner">{r.oneLiner}</p>
            <div class="rank-tags">
              {(r.tags ?? []).slice(0, 3).map((t) => (<span>#{t}</span>))}
            </div>
          </a>
        ))}
      </div>
    </div>
    <aside class="fav">
      <div class="fav-chip">my favorite</div>
      {myFavorite && <ReviewImage r={myFavorite} variant="card" height={140} />}
      <p class="fav-body">
        どんなときもやさしくしてくれる<br />最高の味です。
      </p>
      <div class="fav-bear"><BearDoodle size={56} /></div>
    </aside>
  </section>

  <!-- ARCHIVE strip -->
  <section class="arch-strip">
    <div class="arch-head">
      <h2>archive</h2>
      <div class="chips" data-arch-chips>
        {yearChips.map((y, i) => (
          <button type="button" data-bucket={y} class={`chip ${i === 0 ? 'active' : ''}`}>{y}</button>
        ))}
      </div>
      <a class="more" href="/archive">すべて見る →</a>
    </div>
    <div class="card-grid-6" data-archive-grid>
      {archive.map((r) => {
        const yb = yearBucketOf(r.date);
        return (
          <a href={`/reviews/${r.slug}`} class="strip-card" data-buckets={`すべて ${yb}`}>
            <ReviewImage r={r} variant="card" height={140} />
            <div class="strip-meta">
              <div class="strip-date">{r.date}</div>
              <div class="strip-name">『{r.name}』</div>
              <div class="strip-one">{r.oneLiner}</div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <script>
    // Home "review" section: chip-driven category filter (cap 5)
    (function () {
      const chipsRoot = document.querySelector('[data-nr-chips]') as HTMLElement | null;
      const grid = document.querySelector('[data-nr-grid]') as HTMLElement | null;
      if (!chipsRoot || !grid) return;

      const cards = Array.from(
        grid.querySelectorAll('[data-nr-card]')
      ) as HTMLElement[];

      function apply(active: string) {
        let visible = 0;
        cards.forEach((c) => {
          const cat = c.dataset.cat || '';
          const matches = active === 'すべて' || cat === active;
          if (matches && visible < 5) {
            c.style.display = '';
            visible++;
          } else {
            c.style.display = 'none';
          }
        });
        chipsRoot!.querySelectorAll('button[data-cat]').forEach((btn) => {
          const c = (btn as HTMLButtonElement).dataset.cat;
          btn.classList.toggle('active', c === active);
        });
      }

      chipsRoot.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest(
          'button[data-cat]'
        ) as HTMLButtonElement | null;
        if (!btn) return;
        apply(btn.dataset.cat || 'すべて');
      });

      apply('すべて');
    })();

    // Home archive section: chip-driven year filter (cap 10 = 5 cols × 2 rows)
    (function () {
      const chipsRoot = document.querySelector('[data-arch-chips]') as HTMLElement | null;
      const grid = document.querySelector('[data-archive-grid]') as HTMLElement | null;
      if (!chipsRoot || !grid) return;

      const cards = Array.from(
        grid.querySelectorAll('.strip-card[data-buckets]')
      ) as HTMLAnchorElement[];

      function apply(active: string) {
        let visible = 0;
        cards.forEach((c) => {
          const bs = (c.dataset.buckets || '').split(/\s+/);
          const matches = bs.includes(active);
          if (matches && visible < 10) {
            c.style.display = '';
            visible++;
          } else {
            c.style.display = 'none';
          }
        });
        chipsRoot!.querySelectorAll('button[data-bucket]').forEach((btn) => {
          const b = (btn as HTMLButtonElement).dataset.bucket;
          btn.classList.toggle('active', b === active);
        });
      }

      chipsRoot.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest(
          'button[data-bucket]'
        ) as HTMLButtonElement | null;
        if (!btn) return;
        apply(btn.dataset.bucket || 'すべて');
      });

      apply('すべて');
    })();
  </script>

<style>
section { padding: 0 40px 40px; }
.hero {
  padding: 20px 40px 48px;
  display: grid;
  grid-template-columns: 240px 1fr 260px;
  gap: 28px;
  align-items: start;
  position: relative;
}
.hero-l { font-family: var(--font-display); position: relative; }
.hero-my { font-size: 48px; font-style: italic; color: var(--accent); line-height: 1; margin-left: 14px; }
.hero-jp {
  font-family: var(--font-logo);
  font-weight: 800;
  font-size: 60px;
  letter-spacing: -0.2px;
  color: var(--accent-deeper);
  line-height: 1;
  margin-top: 6px;
  display: inline-block;
  position: relative;
}
.hero-jp-main { white-space: nowrap; }
.hero-diary {
  position: absolute;
  top: calc(100% + 6px);
  right: 4px;
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 600;
  font-size: 22px;
  color: var(--accent);
  letter-spacing: 0.5px;
  line-height: 1;
}
.hero-rev { font-size: 48px; font-style: italic; color: var(--accent); line-height: 1; margin-top: 8px; margin-left: 14px; }
.hero-lead { font-size: 12px; margin-top: 18px; line-height: 1.9; color: var(--ink-tertiary); font-family: var(--font-jp); }
.hero-decor { display: flex; gap: 8px; margin-top: 14px; opacity: 0.7; }

.hero-c { position: relative; padding: 0; display: flex; flex-direction: column; align-items: center; }
.hero-photo {
  position: relative;
  /* width: 92% → 80% にして hero photo を縮小 (中央列 1fr の 80% 幅) */
  width: 80%;
  aspect-ratio: 16 / 9;
  margin: 0 auto;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 64px / 48px;
  padding: 10px;
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.hero-photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 56px / 40px;
}
.hero-bear {
  position: absolute;
  left: 50%;
  bottom: -28px;
  z-index: 4;
  transform: translateX(-50%);
}

.hero-r {
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 20px;
  padding: 28px 18px 22px;
  position: relative;
  box-shadow: var(--shadow-card);
  align-self: stretch;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14px;
}
.about-avatar {
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: var(--list-active);
  overflow: hidden;
  flex-shrink: 0;
}
.about-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
}
.about-chip {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 22px;
  color: var(--accent);
  line-height: 1;
}
.about-body {
  font-size: 12px;
  line-height: 1.9;
  color: var(--ink-secondary);
  font-family: var(--font-jp);
  margin: 0;
}
.about-cta {
  display: inline-block;
  margin-top: auto;
  padding: 8px 24px;
  font-size: 14px;
  background: transparent;
  border: 1.2px solid var(--accent);
  color: var(--accent);
  border-radius: 999.008px;
  font-family: var(--font-display);
  font-style: italic;
  text-decoration: none;
}
.about-cta:hover { background: var(--list-active); }

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
  gap: 16px;
}
.section-head h2 {
  font-family: var(--font-display);
  font-size: 28px;
  color: var(--accent);
  font-style: italic;
  margin: 0;
  display: inline-flex;
  align-items: center;
  flex-direction: column;
  align-items: flex-start;
  line-height: 1;
}
.chips { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
.chip {
  /* chip は <a> と <button> の両方で使う。button のネイティブ装飾を抑止 */
  appearance: none;
  -webkit-appearance: none;
  font-size: 11px;
  padding: 5px 14px;
  border-radius: 999.008px;
  border: 1px solid #cfe0f0;
  background: transparent;
  color: var(--ink-tertiary);
  cursor: pointer;
  font-family: var(--font-jp);
  text-decoration: none;
  transition: all 0.15s;
}
.chip:hover { border-color: var(--accent); color: var(--accent); }
.chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.more { font-size: 12px; color: var(--accent); font-family: var(--font-display); font-style: italic; text-decoration: none; }
.more:hover { text-decoration: underline; }

.card-grid-5 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
.review-cell { display: contents; }

.ranking { padding: 28px 40px 40px; display: grid; grid-template-columns: 1fr 300px; gap: 28px; }
.ranking-l h2 {
  font-family: var(--font-display);
  font-size: 32px;
  color: var(--accent);
  font-style: italic;
  margin: 0 0 24px;
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.ranking-l h2 .crown { font-size: 22px; margin-right: 6px; color: var(--accent-soft); }
.rank-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.rank-card {
  position: relative;
  display: block;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 16px;
  overflow: visible;
  text-decoration: none;
  color: inherit;
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease;
}
.rank-card:hover { transform: translateY(-3px); }
.rank-card.r-1 { border: 2px solid var(--accent); }
.rank-no {
  position: absolute;
  top: -26px;
  left: 12px;
  z-index: 5;
  font-family: var(--font-display);
  font-size: 38px;
  font-style: italic;
  color: var(--accent);
  font-weight: 700;
  line-height: 1;
  pointer-events: none;
  text-shadow: 1px 1px 0 #fff, -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff;
}
.rank-rating { margin-top: 10px; }
.rank-name { font-size: 13px; font-weight: 700; margin-top: 8px; color: var(--ink-primary); font-family: var(--font-jp); }
.rank-oneliner { font-size: 11px; line-height: 1.6; margin-top: 4px; color: var(--ink-secondary); }
.rank-tags { display: flex; gap: 4px; margin-top: 8px; flex-wrap: wrap; }
.rank-tags span { font-size: 10px; color: var(--accent); opacity: 0.8; }

.fav { background: var(--bg-card); border: var(--border-card); border-radius: 20px; padding: 18px; position: relative; box-shadow: var(--shadow-card); }
.fav-chip {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  font-family: var(--font-display);
  font-size: 13px;
  font-style: italic;
  padding: 4px 14px;
  border-radius: 999.008px;
  margin-bottom: 12px;
}
.fav-body { font-size: 11px; line-height: 1.7; margin-top: 14px; color: var(--ink-tertiary); }
.fav-bear { position: absolute; bottom: 10px; right: 10px; opacity: 0.85; }

.arch-strip h2 { font-family: var(--font-display); font-size: 32px; color: var(--accent); font-style: italic; margin: 0; }

/* arch-head: title + filter chips + "すべて見る →" 誘導リンク。
   review / ranking セクションと同じ配置 (h2 をセクション左端揃え) に統一する。
   h2 はセクション左端、chips は中央、"すべて見る →" はセクション右端。 */
.arch-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  margin: 0 0 18px;
}
.arch-head .chips {
  flex: 1 1 auto;
  justify-content: center;
  margin: 0;
}

/* archive teaser grid: review (.card-grid-5) と同じ 5 列構造で揃え、2 行 (cap 10) を表示する。
   h2/arch-head と左端を一致させるため左揃え (justify-content 指定なし = start)。 */
.card-grid-6 { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px 20px; }
.strip-card {
  display: block;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 14px;
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  box-shadow: var(--shadow-card);
  transition: transform 0.18s ease;
}
.strip-card:hover { transform: translateY(-2px); }
.strip-meta { padding: 8px 10px 12px; }
.strip-date { font-size: 10px; color: var(--ink-tertiary-2); }
.strip-name { font-size: 11px; font-weight: 600; margin-top: 2px; color: var(--ink-primary); }
.strip-one { font-size: 10px; color: var(--ink-tertiary-2); margin-top: 1px; line-height: 1.4; }

@media (max-width: 768px) {
  section { padding: 0 16px 32px; }
  .hero {
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 16px 16px 32px;
  }
  .hero-l { text-align: center; }
  .hero-my, .hero-rev { font-size: 32px; margin-left: 0; }
  .hero-jp { font-size: clamp(36px, 9vw, 52px); }
  .hero-diary { font-size: 16px; top: calc(100% + 4px); }
  .hero-photo { height: 200px; }
  .hero-bubble { right: 16px; top: 30px; }
  .hero-bear { right: 70px; }
  .section-head { flex-direction: column; align-items: flex-start; gap: 8px; }
  .chips { overflow-x: auto; flex-wrap: nowrap; max-width: 100%; padding-bottom: 4px; }
  .chip { white-space: nowrap; flex-shrink: 0; }
  .card-grid-5 { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .ranking { grid-template-columns: 1fr; gap: 16px; padding: 16px 16px 32px; }
  .rank-grid { grid-template-columns: 1fr; }
  .arch-strip h2 { font-size: 22px; }
  .arch-head { flex-direction: column; align-items: stretch; gap: 10px; }
  .arch-head .chips { overflow-x: auto; flex-wrap: nowrap; max-width: 100%; padding-bottom: 4px; }
  .arch-head .more { align-self: flex-end; }
  .card-grid-6 { grid-template-columns: repeat(2, 1fr); gap: 8px; }
  body { padding-bottom: 64px; }
}
</style>
