---
import BearDoodle from '../BearDoodle.astro';
import WashiTape from '../WashiTape.astro';
import HandGlass from '../HandGlass.astro';
import HandBottle from '../HandBottle.astro';
import HeartIcon from '../HeartIcon.astro';
import HeartsRating from '../HeartsRating.astro';
import Star from '../Star.astro';

interface Criterion {
  key: string;
  label: string;
  desc: string;
  value: number;
}

interface ProfileItem {
  key: string;
  icon: string;
  label: string;
  value: any;
}

interface Capability {
  icon?: string;
  title: string;
  body: string;
}

interface Topic {
  title: string;
  body: string;
}

interface Props {
  Content: any;
  data: any;
  criteria: readonly Criterion[];
  profileItems: ProfileItem[];
  capabilities: Capability[];
  topics: Topic[];
}

const { Content, data, criteria, profileItems, capabilities, topics } = Astro.props;
---
<!-- ───────── HERO ───────── -->
<section class="hero">
  <div class="hero-l">
    <div class="hero-title">
      <BearDoodle size={92} class="hero-bear" />
      <div>
        <h1>about</h1>
        <div class="sub">このサイトと運営者について</div>
      </div>
    </div>
    <p class="catch">
      エミエルがくれる、<br />
      ちいさな幸せを記録する場所。
    </p>
    <p class="lede">
      「エミエルって、なんでこんなにおいしいんだろう？」<br />
      そんな気持ちから生まれた、エミエル愛あふれるレビュー日誌です。<br />
      あなたのお気に入りが見つかるきっかけになれたらうれしいです。
    </p>
    <div class="hero-deco-dot"></div>
  </div>

  <div class="hero-r">
    <div class="hero-image-wrap">
      <img src="/images/Emiel-main-image.png" alt="エミエルとお花のイラスト" loading="eager" />
    </div>
    <div class="hero-bear-r">
      <BearDoodle size={78} />
    </div>
  </div>
</section>

<!-- ───────── ABOUT + PROFILE GRID ───────── -->
<div class="grid-2col">
  <div class="grid-l">
    <section class="lead">
      <h2>このサイトについて <span class="kira"><Star size={10} color="var(--accent-soft)" /><Star size={6} color="var(--accent-soft)" /></span></h2>
      <div class="lead-row">
        <div class="lead-body">
          <Content />
        </div>
        <div class="lead-glass"><HandGlass size={56} opacity={0.85} /></div>
      </div>

      <article class="criteria">
        <header class="criteria-head">
          <h3>レビューの基準</h3>
          <span class="criteria-note">5つの視点で 5.0 点満点で評価しています！</span>
        </header>
        <div class="criteria-grid">
          {criteria.map((c) => (
            <div class="criterion">
              <div class={`crit-icon ic-${c.key}`} aria-hidden="true">
                {c.key === 'taste' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round">
                    <circle cx="12" cy="12" r="9" />
                    <circle cx="9" cy="10" r="0.8" fill="var(--accent)" />
                    <circle cx="15" cy="10" r="0.8" fill="var(--accent)" />
                    <path d="M8.5 14.5q3.5 2.5 7 0" />
                  </svg>
                )}
                {c.key === 'drink' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round">
                    <path d="M7 6h10l-1.4 13a2 2 0 0 1-2 1.8h-3.2a2 2 0 0 1-2-1.8z" />
                    <path d="M7.6 10h8.8" />
                  </svg>
                )}
                {c.key === 'special' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round">
                    <path d="M12 3l2.4 5.6 6.1.5-4.7 4 1.5 6-5.3-3.2-5.3 3.2 1.5-6-4.7-4 6.1-.5z" />
                  </svg>
                )}
                {c.key === 'repeat' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round">
                    <path d="M8 6h8l-1.2 12a2 2 0 0 1-2 1.8h-1.6a2 2 0 0 1-2-1.8z" />
                    <path d="M11 3l-1.5 3M13 3l1.5 3" />
                  </svg>
                )}
                {c.key === 'aftertaste' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 14q3-4 6 0t6 0t6 0" />
                    <path d="M3 9q3-3 6 0t6 0t6 0" opacity="0.55" />
                  </svg>
                )}
              </div>
              <div class="crit-label">{c.label}</div>
              <div class="crit-desc">{c.desc.split('\n').map((l, i) => <>{i > 0 && <br />}{l}</>)}</div>
              <div class="crit-rating"><HeartsRating value={c.value} size={13} showValue={false} /></div>
            </div>
          ))}
        </div>
      </article>
    </section>

    <section class="capabilities">
      <h2>このサイトでできること <span class="kira"><Star size={10} color="var(--accent-soft)" /><Star size={6} color="var(--accent-soft)" /></span></h2>
      <div class="cap-grid">
        {capabilities.map((cap) => (
          <article class="cap-card">
            <div class={`cap-icon ic-${cap.icon ?? 'cup'}`} aria-hidden="true">
              {cap.icon === 'cup' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round">
                  <path d="M7 6h10l-1.4 13a2 2 0 0 1-2 1.8h-3.2a2 2 0 0 1-2-1.8z" />
                  <path d="M11 3v3M13 3v3" stroke-linecap="round" />
                </svg>
              )}
              {cap.icon === 'sparkle' && (
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v4M12 16v4M4 12h4M16 12h4" />
                  <path d="M7.5 7.5l2 2M14.5 14.5l2 2M16.5 7.5l-2 2M9.5 14.5l-2 2" />
                </svg>
              )}
              {cap.icon === 'heart' && (
                <HeartIcon size={22} color="var(--accent)" />
              )}
            </div>
            <h3>{cap.title}</h3>
            <p>{cap.body}</p>
            <div class="cap-illus">
              {cap.icon === 'cup' && <HandBottle size={62} opacity={0.85} />}
              {cap.icon === 'sparkle' && <HandGlass size={50} opacity={0.85} />}
              {cap.icon === 'heart' && <BearDoodle size={56} />}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <!-- ───────── PROFILE SIDEBAR ───────── -->
  <aside class="profile">
    <WashiTape width={60} rotate={-4} style="position:absolute;top:-12px;left:24px;" />
    <WashiTape width={48} rotate={8} style="position:absolute;top:-10px;right:22px;" />
    <div class="prof-head">
      <div class="prof-avatar"><img src={data?.avatar ?? '/images/about-me.png'} alt="" /></div>
      <div class="prof-chip">about me</div>
    </div>
    <div class="prof-catch">{data?.catch}</div>
    <p class="prof-intro">{data?.intro}</p>
    <div class="prof-divider"></div>
    <ul class="prof-list">
      {profileItems.map((it) => (
        <li>
          <div class={`prof-icon ic-${it.icon}`} aria-hidden="true">
            {it.icon === 'cup' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round">
                <path d="M8 6h8l-1.2 12a2 2 0 0 1-2 1.8h-1.6a2 2 0 0 1-2-1.8z" />
                <path d="M9 9.5h6" stroke-linecap="round" />
              </svg>
            )}
            {it.icon === 'heart' && <HeartIcon size={18} color="var(--accent)" />}
            {it.icon === 'clock' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round">
                <circle cx="12" cy="12" r="8" />
                <path d="M12 8v4l2.5 2" />
              </svg>
            )}
            {it.icon === 'ice' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round">
                <rect x="5" y="5" width="6" height="6" rx="1" />
                <rect x="13" y="9" width="6" height="6" rx="1" />
                <rect x="7" y="13" width="6" height="6" rx="1" />
              </svg>
            )}
            {it.icon === 'cal' && (
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round">
                <rect x="4" y="6" width="16" height="14" rx="2" />
                <path d="M4 10h16M9 4v4M15 4v4" stroke-linecap="round" />
              </svg>
            )}
          </div>
          <div class="prof-text">
            <div class="prof-label">{it.label}</div>
            <div class="prof-value">{it.value}</div>
          </div>
        </li>
      ))}
    </ul>
  </aside>
</div>

<!-- ───────── もう少し詳しく ───────── -->
<section class="topics">
  <h2>もう少し詳しく <span class="kira"><Star size={10} color="var(--accent-soft)" /><Star size={6} color="var(--accent-soft)" /></span></h2>
  <div class="topics-grid">
    {topics.map((t, i) => (
      <article class="topic-card">
        <h3>{t.title}</h3>
        <p>{t.body}</p>
        <div class="topic-illus" aria-hidden="true">
          {i % 3 === 0 && <HandBottle size={56} opacity={0.85} />}
          {i % 3 === 1 && <HeartIcon size={28} color="var(--accent-soft)" />}
          {i % 3 === 2 && <HandGlass size={50} opacity={0.85} />}
        </div>
      </article>
    ))}
  </div>
</section>

<!-- 散らばる装飾 -->
<div class="bg-deco" aria-hidden="true">
  <span class="dot d1"></span>
  <span class="dot d2"></span>
  <span class="dot d3"></span>
  <span class="dot d4"></span>
  <span class="dot d5"></span>
  <span class="dot d6"></span>
</div>

<style>
/* ─────────────── HERO ─────────────── */
.hero {
  position: relative;
  padding: 18px 40px 28px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 32px;
  align-items: center;
}
.hero-l { position: relative; }
.hero-title { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
.hero-title h1 {
  font-family: var(--font-display);
  font-style: italic;
  font-size: var(--fs-hero);
  color: var(--accent);
  margin: 0;
  line-height: 0.9;
}
.hero-title .sub {
  font-size: 13px;
  color: var(--ink-tertiary);
  margin-top: 6px;
  letter-spacing: 0.02em;
}
.catch {
  font-family: var(--font-jp);
  font-size: 24px;
  line-height: 1.7;
  color: var(--accent);
  margin: 6px 0 16px;
  font-weight: 500;
}
.lede {
  font-size: 12.5px;
  line-height: 2;
  color: var(--ink-tertiary);
  margin: 0;
  max-width: 460px;
}
.hero-deco-dot {
  position: absolute;
  top: 8px;
  right: -16px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-soft);
  opacity: 0.6;
}
.hero-r {
  position: relative;
  max-width: 460px;
  margin-left: -32px;
  width: 100%;
}
.hero-image-wrap {
  position: relative;
  border-radius: 22px;
  overflow: hidden;
  background: linear-gradient(180deg, #fff 0%, #f6fbff 100%);
  box-shadow: 0 6px 22px rgba(122, 169, 217, 0.12);
}
.hero-image-wrap img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10;
  object-fit: cover;
}
.hero-bear-r {
  position: absolute;
  right: 14px;
  bottom: -8px;
  display: flex;
  align-items: flex-end;
  gap: 4px;
  z-index: 3;
}
/* ─────────────── 2-COL GRID ─────────────── */
.grid-2col {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 28px;
  padding: 0 40px;
  align-items: start;
  position: relative;
}
.grid-l { display: flex; flex-direction: column; gap: 36px; min-width: 0; }

/* ─────────────── このサイトについて ─────────────── */
.lead { position: relative; }
.lead h2,
.capabilities h2,
.topics h2 {
  font-family: var(--font-jp);
  font-size: 22px;
  color: var(--ink-primary);
  margin: 0 0 18px;
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
}
.kira { display: inline-flex; align-items: center; gap: 2px; line-height: 1; }

.lead-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 24px;
  align-items: end;
  margin-bottom: 28px;
}
.lead-body {
  font-size: 13px;
  line-height: 2;
  color: var(--ink-secondary);
  font-family: var(--font-jp);
}
.lead-body :global(p) { margin: 0 0 8px; }
.lead-glass {
  margin-right: 12px;
  align-self: end;
}

/* レビューの基準 */
.criteria {
  position: relative;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 22px;
  padding: 22px 26px 18px;
  box-shadow: var(--shadow-card);
}
.criteria-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
.criteria-head h3 {
  font-family: var(--font-jp);
  font-size: 15px;
  color: var(--accent);
  margin: 0;
  font-weight: 600;
}
.criteria-note { font-size: 11px; color: var(--ink-tertiary); }
.criteria-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 18px;
}
.criterion {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.crit-icon {
  width: 38px;
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--list-active);
  border-radius: 50%;
  margin-bottom: 2px;
}
.crit-label {
  font-size: 12px;
  color: var(--ink-primary);
  font-weight: 600;
  font-family: var(--font-jp);
}
.crit-desc {
  font-size: 10.5px;
  color: var(--ink-tertiary);
  line-height: 1.6;
  min-height: 32px;
}
.crit-rating { margin-top: 4px; }

/* ─────────────── このサイトでできること ─────────────── */
.capabilities { position: relative; }
.cap-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.cap-card {
  position: relative;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 18px 18px 80px;
  min-height: 200px;
  box-shadow: var(--shadow-card);
}
.cap-card h3 {
  font-family: var(--font-jp);
  font-size: 14px;
  color: var(--accent);
  margin: 8px 0 8px;
  font-weight: 600;
}
.cap-card p {
  font-size: 11.5px;
  line-height: 1.85;
  color: var(--ink-tertiary);
  margin: 0;
  padding-right: 56px;
}
.cap-icon {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--list-active);
  border-radius: 50%;
}
.cap-illus {
  position: absolute;
  right: 14px;
  bottom: 12px;
  opacity: 0.85;
  pointer-events: none;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
}

/* ─────────────── PROFILE SIDEBAR ─────────────── */
.profile {
  position: relative;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 22px;
  padding: 24px 22px 22px;
  box-shadow: var(--shadow-card);
  align-self: start;
}
.prof-head { display: flex; align-items: center; gap: 12px; }
.prof-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--list-active);
  overflow: hidden;
  flex-shrink: 0;
  border: 1px solid rgba(168, 200, 232, 0.4);
}
.prof-avatar img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.prof-chip {
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  padding: 5px 14px;
  border-radius: 12px;
  font-family: var(--font-display);
  font-style: italic;
}
.prof-catch {
  font-family: var(--font-jp);
  font-size: 14px;
  color: var(--ink-primary);
  font-weight: 600;
  margin: 14px 0 8px;
  line-height: 1.7;
}
.prof-intro {
  font-size: 11px;
  line-height: 1.85;
  color: var(--ink-tertiary);
  margin: 0;
}
.prof-divider {
  border-top: var(--border-divider);
  margin: 18px 0 14px;
}
.prof-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.prof-list li { display: flex; align-items: center; gap: 12px; }
.prof-icon {
  width: 30px;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--list-active);
  border-radius: 50%;
  flex-shrink: 0;
}
.prof-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.prof-label { font-size: 10.5px; color: var(--ink-tertiary); font-family: var(--font-jp); }
.prof-value { font-size: 12px; color: var(--ink-primary); font-family: var(--font-jp); font-weight: 500; }

/* ─────────────── もう少し詳しく ─────────────── */
.topics {
  padding: 28px 40px 36px;
  position: relative;
}
.topics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}
.topic-card {
  position: relative;
  background: var(--bg-card);
  border: var(--border-card);
  border-radius: 18px;
  padding: 18px 18px 14px;
  box-shadow: var(--shadow-card);
  min-height: 170px;
}
.topic-card h3 {
  font-family: var(--font-jp);
  font-size: 14px;
  color: var(--accent);
  margin: 0 0 10px;
  font-weight: 600;
}
.topic-card p {
  font-size: 11.5px;
  line-height: 1.95;
  color: var(--ink-tertiary);
  white-space: pre-line;
  margin: 0;
  max-width: 90%;
}
.topic-illus {
  position: absolute;
  right: 14px;
  bottom: 10px;
  opacity: 0.9;
}

/* ─────────────── 散らばる装飾 ─────────────── */
.bg-deco { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.bg-deco .dot {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-soft);
  opacity: 0.45;
}
.bg-deco .d1 { top: 120px; left: 28px; }
.bg-deco .d2 { top: 200px; right: 18px; width: 5px; height: 5px; }
.bg-deco .d3 { top: 520px; left: 12px; width: 4px; height: 4px; }
.bg-deco .d4 { top: 720px; right: 8px; }
.bg-deco .d5 { top: 1020px; left: 24px; width: 5px; height: 5px; }
.bg-deco .d6 { top: 1280px; right: 28px; width: 5px; height: 5px; }

/* ─────────────── MOBILE ─────────────── */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 18px;
    padding: 16px 16px 24px;
  }
  .hero-title h1 { font-size: clamp(36px, 9vw, 56px); }
  .catch { font-size: 18px; }
  .lede { font-size: 12px; }
  .hero-r { max-width: none; margin-left: 0; }
  .hero-image-wrap { border-radius: 18px; }
  .hero-bear-r { right: 8px; bottom: -8px; }

  .grid-2col {
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 0 16px;
  }
  .lead-row { grid-template-columns: 1fr; gap: 14px; }
  .lead-glass { align-self: flex-start; margin-right: 0; }
  .criteria { padding: 18px 16px 14px; }
  .criteria-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .cap-grid { grid-template-columns: 1fr; gap: 12px; }
  .cap-card { min-height: 0; padding-bottom: 70px; }
  .cap-card p { padding-right: 70px; }
  .cap-illus { right: 12px; bottom: 8px; }

  .profile { padding: 22px 18px 20px; }

  .topics { padding: 12px 16px 32px; }
  .topics-grid { grid-template-columns: 1fr; gap: 14px; }
  .topic-card { min-height: 0; padding-bottom: 50px; }

  .bg-deco { display: none; }
  body { padding-bottom: 64px; }
}
</style>
