---
interface Props { size?: number; class?: string; style?: string; }
const { size = 80, class: className = '', style = '' } = Astro.props;
const h = Math.round(size * (123 / 129));
---
<img
  src="/images/bear-doodle.png"
  alt=""
  width={size}
  height={h}
  class={className}
  style={`display:inline-block;vertical-align:middle;${style}`}
  aria-hidden="true"
/>
