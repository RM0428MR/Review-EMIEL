---
interface Props { size?: number; opacity?: number; style?: string; }
const { size = 70, opacity = 1, style = '' } = Astro.props;
const h = Math.round(size * (88 / 62));
---
<img
  src="/images/calpis_cup.png"
  alt=""
  width={size}
  height={h}
  style={`display:block;opacity:${opacity};${style}`}
  aria-hidden="true"
/>
