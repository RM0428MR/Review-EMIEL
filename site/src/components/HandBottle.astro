---
interface Props { size?: number; opacity?: number; style?: string; }
const { size = 80, opacity = 1, style = '' } = Astro.props;
---
<img
  src="/images/hand-bottle.png"
  alt=""
  width={Math.round(size * 0.48)}
  height={size}
  style={`display:block;opacity:${opacity};${style}`}
  aria-hidden="true"
/>
